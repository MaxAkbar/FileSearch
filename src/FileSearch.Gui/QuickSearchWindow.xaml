<Window x:Class="FileSearch.Gui.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:FileSearch.Gui.ViewModels"
        xmlns:conv="clr-namespace:FileSearch.Gui.Converters"
        xmlns:controls="clr-namespace:FileSearch.Gui.Controls"
        xmlns:hl="clr-namespace:FileSearch.Gui.Highlighting"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:QuickSearchViewModel}"
        ui:WindowHelper.UseModernWindowStyle="False"
        Icon="Assets/FileSearch.ico"
        Background="{DynamicResource Atlas.PaperBrush}"
        Foreground="{DynamicResource Atlas.InkBrush}"
        FontFamily="{DynamicResource Atlas.SansFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Title="Quick Search"
        Width="760"
        Height="540"
        MinWidth="640"
        MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:FileTypeToBrushConverter x:Key="TypeBrush"/>
        <conv:FileTypeToLabelConverter x:Key="TypeLabel"/>
    </Window.Resources>

    <Border Background="{DynamicResource Atlas.PaperBrush}"
            BorderBrush="{DynamicResource Atlas.Line2Brush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{DynamicResource AppDensity.QuickSearchPadding}">
        <Grid x:Name="QuickSearchLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="QuickSearchBar" Grid.Row="0" Style="{StaticResource OmniBarStyle}" Height="{DynamicResource AppDensity.QuickSearchOmniBarHeight}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE721;"
                                 FontSize="17"
                                 Foreground="{DynamicResource Atlas.Ink3Brush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox"
                             AutomationProperties.Name="Quick Search query"
                             Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource OmniQueryBoxStyle}"
                             ui:ControlHelper.PlaceholderText="Search files, paths, and indexed content"/>
                    <CheckBox x:Name="QuickContentToggle" Grid.Column="2"
                              Content="Content"
                              Foreground="{DynamicResource Atlas.InkBrush}"
                              IsChecked="{Binding IncludeContentMatches, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanSearchContent}"
                              ToolTip="{Binding ContentSearchSummary}"
                              VerticalAlignment="Center"
                              Margin="12,0,8,0"/>
                    <Border Grid.Column="3" Style="{StaticResource OmniDividerStyle}"/>
                    <ComboBox x:Name="QuickLocationScope" Grid.Column="4"
                              Foreground="{DynamicResource Atlas.InkBrush}" Background="{DynamicResource Atlas.SurfaceBrush}"
                              BorderBrush="{DynamicResource Atlas.Line2Brush}"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedItem="{Binding SelectedScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="Quick Search location scope"
                              ToolTip="Choose which folder or indexed locations Quick Search uses"
                              VerticalAlignment="Center"
                              MinHeight="30">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Grid>
            </Border>

            <StackPanel x:Name="QuickScopeHeader" Grid.Row="1" Margin="2,9,2,8">
                <Border BorderBrush="{DynamicResource Atlas.LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource Atlas.Surface2Brush}"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsFolderScope, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folder"
                                   Style="{StaticResource StatusStrongStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding QuickFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OmniPathBoxStyle}"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="Choose Quick Search folder"
                                Command="{Binding ChooseQuickFolderCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="{DynamicResource AppDensity.QuickFolderButtonSize}"
                                Height="{DynamicResource AppDensity.QuickFolderButtonSize}"
                                Margin="8,0,0,0"
                                ToolTip="Choose folder">
                            <ui:FontIcon Glyph="&#xE838;" FontSize="13"/>
                        </Button>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource Atlas.LineBrush}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource Atlas.Surface2Brush}" Padding="8" Margin="0,0,0,8"
                        Visibility="{Binding IsSelectedIndexedScope, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ToggleButton x:Name="QuickLocationSelectionButton" Content="{Binding LocationSelectionSummary}"
                                      FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                                      Width="Auto" MinWidth="100"
                                      Command="{Binding RefreshLocationSelectionsCommand}"
                                      HorizontalAlignment="Left" MinHeight="28" Padding="9,3"
                                      Style="{StaticResource InlineToggleButtonStyle}"
                                      ToolTip="Choose the indexed locations included in Quick Search"
                                      AutomationProperties.Name="Choose Quick Search indexed locations"/>
                        <Popup PlacementTarget="{Binding ElementName=QuickLocationSelectionButton}"
                               IsOpen="{Binding IsChecked, ElementName=QuickLocationSelectionButton, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                            <Border Style="{StaticResource DropdownCardStyle}" Width="430"
                                    DataContext="{Binding DataContext, ElementName=QuickLocationSelectionButton}"
                                    PreviewKeyDown="OnWindowPreviewKeyDown"
                                    KeyboardNavigation.TabNavigation="Cycle">
                                <StackPanel>
                                    <TextBlock Text="Choose indexed locations" Style="{StaticResource MenuSectionLabelStyle}"/>
                                    <TextBlock Text="The checked locations are shared with main search. Clearing every check searches no indexed locations."
                                               TextWrapping="Wrap" Foreground="{DynamicResource Atlas.Ink2Brush}"
                                               FontSize="11.5" Margin="8,0,8,6"/>
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="QuickLocationChoices" ItemsSource="{Binding LocationSelections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.Name="{Binding Root}" Margin="8,4" HorizontalContentAlignment="Stretch">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Atlas.InkBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Root}" FontFamily="{DynamicResource Atlas.MonoFont}" FontSize="11"
                                                                       Foreground="{DynamicResource Atlas.Ink2Brush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StageText}"
                               Style="{StaticResource StatusStrongStyle}" MaxWidth="200" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StageText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Style="{StaticResource StatusTextStyle}"
                               Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}"/>
                    <Button x:Name="OpenFullSearchButton" Grid.Column="2" Content="Open full search"
                            Command="{Binding OpenFullSearchCommand}" ToolTip="{Binding FullSearchHandoffSummary}"
                            AutomationProperties.Name="Open Quick Search query in full search"
                            Style="{StaticResource UnderlineLinkButtonStyle}" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock x:Name="QuickLocationScopeNotice" Text="{Binding LocationScopeNotice}"
                           Foreground="{DynamicResource Atlas.Ink2Brush}" FontSize="11" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationScopeNotice}"
                           AutomationProperties.Name="Quick Search location coverage" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <ListBox x:Name="ResultsList"
                         AutomationProperties.Name="Quick Search results"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                         Style="{StaticResource ResultsListStyle}"
                         MouseDoubleClick="OnResultDoubleClick"
                         PreviewMouseLeftButtonDown="OnResultsPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnResultsPreviewMouseMove">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ResultCardContainerStyle}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding DisplayDirectory}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileResultViewModel}">
                            <Grid Margin="{DynamicResource AppDensity.QuickResultCardInnerMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource TypeBadgeStyle}"
                                        Background="{Binding FileName, Converter={StaticResource TypeBrush}}">
                                    <TextBlock Text="{Binding FileName, Converter={StaticResource TypeLabel}}"
                                               Style="{StaticResource TypeBadgeTextStyle}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,14,0">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ResultNameStyle}"/>
                                    <TextBlock Text="{Binding DisplayDirectory}" Style="{StaticResource ResultPathStyle}"/>
                                    <TextBlock Text="{Binding MailSummaryText}" Style="{StaticResource ResultPathStyle}"
                                               Visibility="{Binding HasMailMessage, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding VisibleHits}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding LineNumber}"
                                                               Style="{StaticResource LineNoStyle}"
                                                               Width="{DynamicResource AppDensity.QuickLineNoWidth}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource LineTextStyle}"
                                                               hl:HitHighlight.Hit="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Border Style="{StaticResource HitsPillStyle}" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource HitsPillTextStyle}">
                                            <Run Text="{Binding HitCount, Mode=OneWay}"/><Run Text=" hits"/>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding DataContext.OpenOcrPreviewCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                AutomationProperties.Name="Open OCR preview"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasImageOcrPreview, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                Height="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                ToolTip="Open OCR preview">
                                            <ui:FontIcon Glyph="&#xE8A5;" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                AutomationProperties.Name="Open result"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                Height="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                ToolTip="Open">
                                            <ui:FontIcon Glyph="&#xE8E5;" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.RevealResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                AutomationProperties.Name="Reveal result in Explorer"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                Height="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                ToolTip="Reveal in Explorer">
                                            <ui:FontIcon Glyph="&#xE838;" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.CopyResultPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                AutomationProperties.Name="Copy result path"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                Height="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                ToolTip="Copy path">
                                            <ui:FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.PinResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                AutomationProperties.Name="{Binding PinActionText}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                Height="{DynamicResource AppDensity.PreviewIconButtonSize}"
                                                ToolTip="{Binding PinActionText}">
                                            <ui:FontIcon Glyph="{Binding PinGlyph}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:FontIcon Glyph="&#xE721;" FontSize="38" Opacity="0.22" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No quick results" Style="{StaticResource EmptyTitleStyle}"/>
                    <TextBlock Text="Start typing to stream filename, path, and indexed content matches."
                               Style="{StaticResource EmptyBodyStyle}"/>
                </StackPanel>
            </Grid>

            <Border x:Name="InlinePreviewBorder" Grid.Row="3"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource Atlas.Surface2Brush}"
                    BorderBrush="{DynamicResource Atlas.LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,10,0,0"
                    Height="324" MaxHeight="420">
                <TabControl SelectedIndex="1" Style="{StaticResource FilePreviewTabsStyle}" AutomationProperties.Name="Quick Search preview views">
                    <TabItem Header="Matches">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left"
                                    Visibility="{Binding HasImageOcrPreview, Converter={StaticResource BoolToVisibility}}"
                                    Width="150"
                                    Margin="0,0,10,0"
                                    BorderBrush="{DynamicResource Atlas.LineBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource Atlas.PaperBrush}"
                                    ToolTip="{Binding ImageOcrPreview.Label}"
                                    ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="{Binding ImageOcrPreview.SourceWidth}"
                                            Height="{Binding ImageOcrPreview.SourceHeight}">
                                        <Image Source="{Binding ImageOcrPreview.ImagePath}"
                                               Width="{Binding ImageOcrPreview.SourceWidth}"
                                               Height="{Binding ImageOcrPreview.SourceHeight}"
                                               Stretch="Fill"/>
                                        <Rectangle Canvas.Left="{Binding ImageOcrPreview.X}"
                                                   Canvas.Top="{Binding ImageOcrPreview.Y}"
                                                   Width="{Binding ImageOcrPreview.Width}"
                                                   Height="{Binding ImageOcrPreview.Height}"
                                                   Stroke="#FFFFCE54"
                                                   StrokeThickness="6"
                                                   Fill="#33FFCE54"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBox x:Name="QuickMatchesPreview" Text="{Binding PreviewContent, Mode=OneWay}"
                                     AutomationProperties.Name="Quick Search matching text preview"
                                     Style="{StaticResource PreviewCodeBoxStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="File preview">
                        <controls:FileDocumentPreview x:Name="QuickFileDocumentPreview" Result="{Binding SelectedResult}" FallbackText="{Binding PreviewContent}"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
