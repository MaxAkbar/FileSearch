<Window x:Class="FileSearch.Gui.WorkflowReplacementReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True" Title="Review workflow replacements"
        Width="1120" Height="680" MinWidth="800" MinHeight="460" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Atlas.PaperBrush}" Foreground="{DynamicResource Atlas.InkBrush}" FontFamily="{DynamicResource Atlas.SansFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Review before applying" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Margin="0,8,0,4"/>
            <TextBlock Text="Uncheck items to exclude. Apply checked replaces every proposed match within the approved items. Originals are backed up." TextWrapping="Wrap" Foreground="{DynamicResource Atlas.Ink2Brush}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="ReviewGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" EnableRowVirtualization="True"
                      Background="{DynamicResource Atlas.SurfaceBrush}" Foreground="{DynamicResource Atlas.InkBrush}">
                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/><Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/><Setter Property="Padding" Value="6,8"/></Style></DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.RowStyle>
                <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Apply" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Item" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel Margin="4,5" ToolTip="{Binding Path}">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Atlas.Ink2Brush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="{DynamicResource Atlas.SurfaceBrush}" BorderBrush="{DynamicResource Atlas.LineBrush}" BorderThickness="1" Padding="12">
                <TextBox Text="{Binding SelectedPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Background="Transparent" Foreground="{DynamicResource Atlas.InkBrush}" BorderThickness="0"/>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" MinWidth="90"/>
            <Button x:Name="ApplyButton" Content="Apply checked" IsEnabled="{Binding CanApply}" Click="OnApplyClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" ToolTip="Apply the approved replacements"/>
        </StackPanel>
    </Grid>
</Window>
