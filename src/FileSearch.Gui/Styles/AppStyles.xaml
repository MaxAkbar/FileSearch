            <DataTrigger Binding="{Binding Search.IsPreviewPaneVisible}" Value="False">
                <Setter Property="Width" Value="0"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

