    <Style x:Key="LineIconStyle" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="LineIcon14Style" TargetType="Path" BasedOn="{StaticResource LineIconStyle}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.875" ScaleY="0.875"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LineIcon12Style" TargetType="Path" BasedOn="{StaticResource LineIconStyle}">
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Title bar ===== -->
    <Style x:Key="TitleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Accent tile with the search glyph: the design's app mark. -->
    <Style x:Key="BrandMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.AccentBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.OnAccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,9,0"/>
    </Style>

    <Style x:Key="BrandTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.SerifFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Sidebar: section cards ===== -->
    <Style x:Key="SidebarSectionHeaderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="4,0" MinHeight="26" SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Chevron" Data="{StaticResource Icon.ChevronDown}"
                                  Style="{StaticResource LineIcon14Style}" StrokeThickness="1.5"
                                  Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsible sidebar card. Header = title row content; Tag = header
         actions (e.g. the "+" button) placed at the right of the title row. -->
    <Style x:Key="SidebarSectionStyle" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.NavSectionMargin}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource AppStyle.NavSectionBackground}"
                            BorderBrush="{DynamicResource Atlas.LineBrush}"
                            BorderThickness="{DynamicResource AppStyle.NavSectionBorderThickness}"
                            CornerRadius="8" Padding="4,2,4,4" SnapsToDevicePixels="True"
                            TextElement.Foreground="{DynamicResource Atlas.InkBrush}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" MinHeight="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource SidebarSectionHeaderToggleStyle}"
                                              Focusable="False" VerticalAlignment="Center" Margin="2,0"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>
                            <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarSectionCountStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 22px header "+" and pager arrows. -->
    <Style x:Key="SidebarMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Row-level "x" (remove) and other trailing row actions. -->
    <Style x:Key="SidebarRowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>

    <!-- Section filter box; the search glyph is overlaid at the left. -->
    <Style x:Key="SidebarFilterBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="26,4,24,3"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppStyle.SecondaryButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Selectable sidebar row (recent folders, saved searches, workspaces,
         indexed locations): hover tint; selection = raised white row. -->
    <Style x:Key="SidebarRowItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Padding" Value="10,2,4,2"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AppDensity.SidebarRowHeight}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button-shaped sidebar row (locations, favorites, empty-state actions);
         Tag = "active" bool for the raised look. -->
    <Style x:Key="SidebarRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Padding" Value="10,2,4,2"/>
        <Setter Property="MinHeight" Value="{DynamicResource AppDensity.SidebarRowHeight}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{StaticResource AppStyle.BooleanTrue}">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarRowListStyle" TargetType="ListBox" BasedOn="{StaticResource NavListBoxStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarRowItemStyle}"/>
    </Style>

    <Style x:Key="SidebarRowLabelStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarRowSubStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="SidebarRowIconStyle" TargetType="Path" BasedOn="{StaticResource LineIconStyle}">
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- Muted hint shown in place of an empty section's list. -->
    <Style x:Key="SidebarEmptyHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Underlined text link ("Clear all", "Add to index", "Show whole file"). -->
    <Style x:Key="UnderlineLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentUnderlineLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource UnderlineLinkButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Bottom-of-sidebar command rows (Workflows, Settings, Help). -->
    <Style x:Key="SidebarFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarRowButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
    </Style>

    <!-- Icon rail (collapsed sidebar). -->
    <Style x:Key="RailButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
    </Style>

    <!-- ===== Main surface ===== -->
    <!-- The raised content area beside the sidebar (rounded top-left corner). -->
    <Style x:Key="MainSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="CornerRadius" Value="10,0,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 40px search-bar field shell (folder chip, query box). -->
    <Style x:Key="SearchFieldShellStyle" TargetType="Border">
        <Setter Property="Height" Value="{DynamicResource AppDensity.SearchFieldHeight}"/>
        <Setter Property="Background" Value="{DynamicResource AppStyle.OmniBarBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Borderless input inside a field shell. -->
    <Style x:Key="SearchFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- 28px toggles inside the query box (Aa, .*). -->
    <Style x:Key="InlineToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5"
                            BorderBrush="Transparent" BorderThickness="1"
                            SnapsToDevicePixels="True" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppStyle.IconButtonHoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Atlas.AccentBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.Accent2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bordered dropdown/command buttons in the search bar (file types,
         more options). Height follows the search field. -->
    <Style x:Key="SearchFieldButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SearchOptionsToggleButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource AppDensity.SearchFieldHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Atlas.Line2Brush}" BorderThickness="1"
                            CornerRadius="8" SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppStyle.SecondaryButtonHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Atlas.AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.Accent2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource AppDensity.SearchFieldHeight}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="SearchCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource AppDensity.SearchFieldHeight}"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Dropdown menu rows (file types, folder menu, view menu). -->
    <Style x:Key="MenuRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarRowButtonStyle}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="9,2,9,2"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="MenuSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource OptionGroupLabelStyle}">
        <Setter Property="Margin" Value="8,6,0,4"/>
    </Style>

    <!-- ===== Results header ===== -->
    <Style x:Key="ResultsHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.SerifFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppDensity.ResultsHeadlineFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ResultsSublineStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,3,0,0"/>
    </Style>

    <!-- 32px bordered toolbar button (Answer, Export). -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource AppDensity.ToolbarButtonHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SearchOptionsToggleButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource AppDensity.ToolbarButtonHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="ToolbarIconStyle" TargetType="Path" BasedOn="{StaticResource LineIcon14Style}">
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="ToolbarDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="12,0,4,0"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Popup card used by the search-bar and toolbar dropdowns. -->
    <Style x:Key="DropdownCardStyle" TargetType="Border" BasedOn="{StaticResource FilterMenuCardStyle}">
        <Setter Property="Padding" Value="6"/>
    </Style>

    <!-- ===== Result groups ===== -->
    <Style x:Key="ResultGroupHeaderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" MinHeight="32" Padding="0,0,10,0"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Chevron" Data="{StaticResource Icon.ChevronDown}"
                                  Style="{StaticResource LineIcon14Style}" StrokeThickness="1.5"
                                  Margin="2,0,8,0" RenderTransformOrigin="0.5,0.5"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResultGroupExpanderStyle" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Style="{StaticResource ResultGroupHeaderToggleStyle}"
                                      Focusable="False"/>
                        <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Result cards ===== -->
    <Style x:Key="ResultCardNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.SerifFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Soft type badge ("PY"): tinted fill, darkened ink. -->
    <Style x:Key="SoftTypeBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="{DynamicResource AppStyle.TypeBadgeColoredVisibility}"/>
    </Style>

    <Style x:Key="SoftTypeBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NeutralTypeBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface3Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="{DynamicResource AppStyle.TypeBadgeNeutralVisibility}"/>
    </Style>

    <!-- Favorite / pin buttons on a card: shown on hover, selection, or when set. -->
    <Style x:Key="ResultCardActionsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResultCardIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>

    <!-- ===== Preview card ===== -->
    <Style x:Key="PreviewCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Separate layer behind the card so the soft shadow never blurs text. -->
    <Style x:Key="PreviewCardShadowStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#1F1D1A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PreviewTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.SerifFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PreviewBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PreviewNavButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>

    <!-- Code view rows. -->
    <Style x:Key="PreviewLinesListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PreviewLineItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HitBand" Background="{DynamicResource Atlas.HitBrush}" Opacity="0" />
                        <Border x:Name="SelectBand" Background="{DynamicResource Atlas.SelBrush}" Visibility="Collapsed"/>
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHit}" Value="True">
                            <Setter TargetName="HitBand" Property="Opacity" Value="0.28"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="HitBand" Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectBand" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PreviewLineNumberStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PreviewFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="PreviewPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- ===== Status bar ===== -->
    <Style x:Key="StatusLineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>


</ResourceDictionary>
