    <!-- =====================================================================
         Atlas design system.

         The Atlas.* brushes below are the LIGHT (paper) defaults. Dark / VS
         overlays (added at runtime by ThemeService) redefine the same keys, so
         our surfaces follow the theme. Built-in ModernWpf controls follow the
         SystemControl* keys, which the same overlays also recolor.
         ===================================================================== -->

    <!-- ===== Palette (Light / paper defaults) ===== -->
    <Color x:Key="Atlas.AccentColor">#1E7A46</Color>
    <Color x:Key="Atlas.Accent2Color">#155C34</Color>
    <Color x:Key="Atlas.PaperColor">#F1EEE7</Color>
    <Color x:Key="Atlas.SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Atlas.Surface2Color">#FAF8F3</Color>
    <Color x:Key="Atlas.SidebarColor">#F1EEE7</Color>
    <Color x:Key="Atlas.InkColor">#1F1D1A</Color>
    <Color x:Key="Atlas.Ink2Color">#58534A</Color>
    <Color x:Key="Atlas.Ink3Color">#696459</Color>
    <Color x:Key="Atlas.LineColor">#DDD8CC</Color>
    <Color x:Key="Atlas.Line2Color">#B8B1A3</Color>
    <Color x:Key="Atlas.HoverColor">#0D1F1D1A</Color>
    <Color x:Key="Atlas.SelColor">#141E7A46</Color>
    <Color x:Key="Atlas.AccentTintColor">#1F1E7A46</Color>
    <Color x:Key="Atlas.AccentSoftColor">#141E7A46</Color>
    <Color x:Key="Atlas.OnAccentColor">#FFFFFF</Color>
    <Color x:Key="Atlas.WarmColor">#B86A25</Color>
    <Color x:Key="Atlas.WarmTintColor">#1FB86A25</Color>
    <Color x:Key="Atlas.HitColor">#F9D66B</Color>
    <Color x:Key="Atlas.HitInkColor">#1F1D1A</Color>
    <!-- Deeper chip surface (v2 "s3"), success dot, and the softened accent
         border ("acb") introduced with the Vela v2 skin.

         NOTE: every brush in this dictionary must use StaticResource (or a
         literal) for its Color. This dictionary is parsed once at startup and
         never re-merged, and WPF resolves a Color="{DynamicResource ...}"
         inside a dictionary-hosted brush exactly once — it does NOT re-fire
         when theme overlays swap, which left these surfaces stuck on the
         startup palette. Dark themes recolor by overriding the *Brush keys. -->
    <Color x:Key="Atlas.Surface3Color">#F1EEE7</Color>
    <Color x:Key="Atlas.OkColor">#1E7A46</Color>
    <Color x:Key="Atlas.AccentBorderColor">#991E7A46</Color>
    <SolidColorBrush x:Key="Atlas.Surface3Brush" Color="{StaticResource Atlas.Surface3Color}"/>
    <SolidColorBrush x:Key="Atlas.OkBrush" Color="{StaticResource Atlas.OkColor}"/>
    <SolidColorBrush x:Key="Atlas.AccentBorderBrush" Color="{StaticResource Atlas.AccentBorderColor}"/>
    <SolidColorBrush x:Key="Atlas.PaperBrush"      Color="{StaticResource Atlas.PaperColor}"/>
    <SolidColorBrush x:Key="Atlas.SurfaceBrush"    Color="{StaticResource Atlas.SurfaceColor}"/>
    <SolidColorBrush x:Key="Atlas.Surface2Brush"   Color="{StaticResource Atlas.Surface2Color}"/>
    <SolidColorBrush x:Key="Atlas.SidebarBrush"    Color="{StaticResource Atlas.SidebarColor}"/>
    <SolidColorBrush x:Key="Atlas.InkBrush"        Color="{StaticResource Atlas.InkColor}"/>
    <SolidColorBrush x:Key="Atlas.Ink2Brush"       Color="{StaticResource Atlas.Ink2Color}"/>
    <SolidColorBrush x:Key="Atlas.Ink3Brush"       Color="{StaticResource Atlas.Ink3Color}"/>
    <SolidColorBrush x:Key="Atlas.LineBrush"       Color="{StaticResource Atlas.LineColor}"/>
    <SolidColorBrush x:Key="Atlas.Line2Brush"      Color="{StaticResource Atlas.Line2Color}"/>
    <SolidColorBrush x:Key="Atlas.HoverBrush"      Color="{StaticResource Atlas.HoverColor}"/>
    <SolidColorBrush x:Key="Atlas.SelBrush"        Color="{StaticResource Atlas.SelColor}"/>
    <SolidColorBrush x:Key="Atlas.AccentBrush"     Color="{StaticResource Atlas.AccentColor}"/>
    <SolidColorBrush x:Key="Atlas.Accent2Brush"    Color="{StaticResource Atlas.Accent2Color}"/>
    <SolidColorBrush x:Key="Atlas.AccentTintBrush" Color="{StaticResource Atlas.AccentTintColor}"/>
    <SolidColorBrush x:Key="Atlas.AccentSoftBrush" Color="{StaticResource Atlas.AccentSoftColor}"/>
    <SolidColorBrush x:Key="Atlas.OnAccentBrush"   Color="{StaticResource Atlas.OnAccentColor}"/>
    <SolidColorBrush x:Key="Atlas.WarmBrush"       Color="{StaticResource Atlas.WarmColor}"/>
    <SolidColorBrush x:Key="Atlas.WarmTintBrush"   Color="{StaticResource Atlas.WarmTintColor}"/>
    <SolidColorBrush x:Key="Atlas.HitBrush"        Color="{StaticResource Atlas.HitColor}"/>
    <SolidColorBrush x:Key="Atlas.HitInkBrush"     Color="{StaticResource Atlas.HitInkColor}"/>
    <sys:Boolean x:Key="AppStyle.BooleanTrue">True</sys:Boolean>
