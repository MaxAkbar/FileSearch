    <SolidColorBrush x:Key="AppStyle.ResultHitsPanelBackground" Color="Transparent"/>
    <Thickness x:Key="AppStyle.ResultHitsPanelBorderThickness">0</Thickness>

    <!-- =====================================================================
         Shell
         ===================================================================== -->
    <Style x:Key="AppRootStyle" TargetType="DockPanel">
        <Setter Property="Background" Value="{DynamicResource Atlas.PaperBrush}"/>
    </Style>

    <Style x:Key="ShellStyle" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource Atlas.PaperBrush}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ===== Title bar ===== -->
    <Style x:Key="TitleBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.PaperBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.TitleBarPadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AppDensity.TitleBarMinHeight}"/>
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppDensity.TitleTextFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource AppStyle.TitleTextFontWeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AppStyle.TitleTextForeground}"/>
    </Style>

    <!-- Vela app mark: accent rounded square with a rotated-square glyph. -->
    <Style x:Key="TitleMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2,0,10,0"/>
    </Style>

    <Style x:Key="TitleMarkGlyphStyle" TargetType="Border">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="1.6"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="TitleDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.Line2Brush}"/>
        <Setter Property="Margin" Value="14,0,2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TitleMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Background" Value="{DynamicResource AppStyle.TitleMenuItemBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.TitleMenuItemPadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AppDensity.TitleMenuItemMinHeight}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TitleMenuStyle" TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
        <Setter Property="Background" Value="{DynamicResource AppStyle.TitleMenuBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TitleMenuItemStyle}"/>
    </Style>

    <Style x:Key="TitleStatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppStyle.TitleStatusPillBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppStyle.TitleStatusPillBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource AppStyle.TitleStatusPillBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppStyle.TitleStatusPillCornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.TitleStatusPillPadding}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.TitleStatusPillMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Status bar ===== -->
    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppStyle.StatusBarBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.StatusBarPadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AppDensity.StatusBarMinHeight}"/>
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppStyle.StatusFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppDensity.StatusTextFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Small round status dot (green "ok" in the v2 design). -->
    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Fill" Value="{DynamicResource Atlas.OkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppStyle.StatusPillBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppStyle.StatusPillBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource AppStyle.StatusPillBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppStyle.StatusPillCornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.StatusPillPadding}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.StatusPillMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- =====================================================================
         Sidebar
         ===================================================================== -->
    <Style x:Key="SidebarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.SidebarBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.SidebarPadding}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
    </Style>

    <Style x:Key="LogoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.SerifFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NavSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.NavSectionLabelMargin}"/>
    </Style>

    <Style x:Key="NavSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppDensity.NavSectionHeaderFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarCommandTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Sidebar command rows (Scopes presets, footer actions) -->
    <Style x:Key="NavItemButtonStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource AppStyle.NavItemBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppStyle.NavItemBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.NavItemPadding}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource AppStyle.NavItemBorderThickness}"
                            CornerRadius="{DynamicResource AppStyle.NavItemCornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScopeNavItemButtonStyle" TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Atlas.Accent2Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Plain text link ("Import", "Reset to defaults", "Clear all", rail footer). -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="2,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Accent2Brush}"/>
    </Style>

    <!-- 26px accent avatar circle in the rail footer. -->
    <Style x:Key="SidebarAvatarStyle" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Recent folders / Saved finds lists -->
    <Style x:Key="NavListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <!-- The sidebar sections scroll as a single surface, so the list must
             not be a scroll host itself: drop the default template's
             ScrollViewer (which would swallow mouse-wheel events even when it
             has nothing to scroll) and size the list to its items. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.NavListItemPadding}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- Full value (path / query) on hover, since rows can be truncated. -->
        <Setter Property="ToolTip" Value="{Binding}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AppStyle.NavItemBorderBrush}"
                            BorderThickness="{DynamicResource AppStyle.NavItemBorderThickness}"
                            CornerRadius="{DynamicResource AppStyle.NavItemCornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.SelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.SidebarCardPadding}"/>
        <Setter Property="Margin" Value="0,2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkspaceSidebarCardStyle" TargetType="Border" BasedOn="{StaticResource SidebarItemCardStyle}"/>

    <Style x:Key="SidebarItemTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SidebarItemSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SidebarItemMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SidebarItemSubtitleTextStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.MonoFont}"/>
    </Style>

    <Style x:Key="SidebarAccentPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentTintBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="WorkspaceQueryPillStyle" TargetType="Border" BasedOn="{StaticResource SidebarAccentPillStyle}"/>

    <Style x:Key="SidebarMetaPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SidebarIconChipStyle" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource AppDensity.SidebarChipSize}"/>
        <Setter Property="Height" Value="{DynamicResource AppDensity.SidebarChipSize}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppDensity.SidebarChipCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource AppStyle.SidebarChipBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppStyle.SidebarChipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,1,9,0"/>
    </Style>

    <Style x:Key="SidebarCardActionButtonStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceRunDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Fill" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RunOnLoad}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Atlas.Accent2Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource AppDensity.SidebarSearchBoxMinHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.SidebarSearchBoxPadding}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.SidebarSearchBoxMargin}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SidebarPagerTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="NavSectionCountStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IndexStatusBadgeStyle" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.BadgePadding}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.BadgeMargin}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsQueued}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Atlas.WarmTintBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.WarmBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.WarmBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Atlas.AccentTintBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsIndexingPaused}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.Ink3Brush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IndexStatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="WatchStatusBadgeStyle" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource Atlas.Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.BadgePadding}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.BadgeMargin}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WatchEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Atlas.AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WatchAwareSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Atlas.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Atlas.LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.SurfacePadding}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Index.SelectedIndexedLocation.WatchEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Atlas.AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Atlas.AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Collapsible sidebar section header (SCOPES / RECENT FOLDERS / SAVED FINDS). -->
    <Style x:Key="NavSectionExpanderStyle" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.NavSectionMargin}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border x:Name="SectionChrome"
                            Background="{DynamicResource AppStyle.NavSectionBackground}"
                            BorderBrush="{DynamicResource Atlas.LineBrush}"
                            BorderThickness="{DynamicResource AppStyle.NavSectionBorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          Cursor="Hand"
                                          Foreground="{DynamicResource Atlas.Ink3Brush}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBg"
                                                Background="{DynamicResource AppStyle.NavSectionHeaderBackground}"
                                                BorderBrush="{DynamicResource AppStyle.NavSectionHeaderBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                CornerRadius="8,8,0,0"
                                                Padding="{DynamicResource AppDensity.NavSectionHeaderPadding}"
                                                SnapsToDevicePixels="True"
                                                TextElement.FontSize="10.5" TextElement.FontWeight="Bold"
                                                TextElement.Foreground="{DynamicResource Atlas.Ink3Brush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:FontIcon x:Name="LeftChevron" Glyph="&#xE70D;"
                                                             FontSize="9" VerticalAlignment="Center"
                                                             Margin="0,0,7,0"
                                                             Visibility="{DynamicResource AppStyle.NavSectionChevronLeftVisibility}"
                                                             Foreground="{DynamicResource Atlas.Ink3Brush}"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                <ui:FontIcon x:Name="Chevron" Grid.Column="2" Glyph="&#xE70D;"
                                                             FontSize="9" VerticalAlignment="Center"
                                                             Visibility="{DynamicResource AppStyle.NavSectionChevronRightVisibility}"
                                                             Foreground="{DynamicResource Atlas.Ink3Brush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource Atlas.HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Glyph" Value="&#xE76C;"/>
                                                <Setter TargetName="LeftChevron" Property="Glyph" Value="&#xE76C;"/>
                                                <Setter TargetName="HeaderBg" Property="BorderThickness" Value="0"/>
                                                <Setter TargetName="HeaderBg" Property="CornerRadius" Value="8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="SectionContent"
                                     Padding="{DynamicResource AppDensity.NavSectionContentPadding}"
                                     Visibility="Collapsed"
                                     TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}">
                                <ContentPresenter ContentSource="Content"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="SectionContent" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SectionChrome" Property="BorderBrush" Value="{DynamicResource Atlas.Line2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

