        <Setter Property="Margin" Value="{DynamicResource AppDensity.ResultMetaPillMargin}"/>
    </Style>

    <Style x:Key="ResultMetaKeyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.MonoFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="ResultMetaValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Atlas.MonoFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="MatchLineContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource AppDensity.MatchLinePadding}"/>
        <Setter Property="Margin" Value="{DynamicResource AppDensity.MatchLineMargin}"/>
    </Style>

    <!-- Scrollbars intentionally NOT restyled: the v2 design's 11px overlay
         thumb (no arrows, no track paging) was unusable without a mouse
         wheel, so Vela uses the same ModernWpf scrollbars as the other
         styles. They follow Vela's light/dark base automatically. -->

</ResourceDictionary>
