<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Vela.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Vela v2 light token set. Layout, density, and switches come from
         Vela.xaml; every brush there references these Color keys through
         DynamicResource, so recoloring is enough. -->

    <Color x:Key="Atlas.AccentColor">#6442F0</Color>
    <Color x:Key="Atlas.Accent2Color">#5734E0</Color>
    <Color x:Key="Atlas.PaperColor">#F8F8FB</Color>
    <Color x:Key="Atlas.SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Atlas.Surface2Color">#FFFFFF</Color>
    <Color x:Key="Atlas.Surface3Color">#EEEEF4</Color>
    <Color x:Key="Atlas.SidebarColor">#F5F5F9</Color>
    <Color x:Key="Atlas.InkColor">#1A1A24</Color>
    <Color x:Key="Atlas.Ink2Color">#5C5C6A</Color>
    <Color x:Key="Atlas.Ink3Color">#8A8A98</Color>
    <Color x:Key="Atlas.LineColor">#1A141228</Color>
    <Color x:Key="Atlas.Line2Color">#29141228</Color>
    <Color x:Key="Atlas.HoverColor">#0D141228</Color>
    <Color x:Key="Atlas.SelColor">#176442F0</Color>
    <Color x:Key="Atlas.AccentTintColor">#266442F0</Color>
    <Color x:Key="Atlas.AccentSoftColor">#176442F0</Color>
    <Color x:Key="Atlas.AccentBorderColor">#4D6442F0</Color>
    <Color x:Key="Atlas.OnAccentColor">#FFFFFF</Color>
    <Color x:Key="Atlas.OkColor">#1F9D63</Color>
    <Color x:Key="Atlas.WarmColor">#C8862A</Color>
    <Color x:Key="Atlas.WarmTintColor">#26C8862A</Color>
    <Color x:Key="Atlas.HitColor">#216442F0</Color>
    <Color x:Key="Atlas.HitInkColor">#5734E0</Color>

    <!-- Literals in Vela.xaml that don't route through the Color keys. -->
    <SolidColorBrush x:Key="SystemControlDisabledBaseLowBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#14141228"/>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#556442F0"/>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#776442F0"/>
    <Color x:Key="SystemAccentColor">#6442F0</Color>
    <SolidColorBrush x:Key="AppStyle.PreviewImageBackground" Color="#FFFFFF"/>

</ResourceDictionary>
