<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Atlas — the warm "paper" Light theme.

        This overlay maps the Atlas palette onto ModernWpf's SystemControl*
        brush keys so the built-in controls (ComboBox, DatePicker, CheckBox,
        ScrollBar, menus, flyouts) pick up the warm look.

        It also defines the full Atlas.* color token set (matching the
        AppStyles.xaml light defaults) so the three built-in themes stay
        structurally symmetric: anything realized while this theme is active —
        gradient stops, freshly parsed style overlays, late-realized deferred
        resources, custom-theme companion lookups — resolves this theme's
        values instead of whichever theme happened to define the token last.
    -->

    <!-- Window / page background -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F1EEE7"/>

    <!-- Card / panel surfaces -->
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeHighBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush"       Color="#FAF8F3"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"         Color="#FFFFFF"/>

    <!-- List rows / hover -->
    <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush"    Color="#FAF8F3"/>
    <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="#11000000"/>

    <!-- ===== Our surfaces (Atlas.*) — light token set, mirrors AppStyles.xaml ===== -->
    <Color x:Key="Atlas.AccentColor">#1E7A46</Color>
    <Color x:Key="Atlas.Accent2Color">#155C34</Color>
    <Color x:Key="Atlas.PaperColor">#F1EEE7</Color>
    <Color x:Key="Atlas.SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Atlas.Surface2Color">#FAF8F3</Color>
    <Color x:Key="Atlas.SidebarColor">#F1EEE7</Color>
    <Color x:Key="Atlas.InkColor">#1F1D1A</Color>
    <Color x:Key="Atlas.Ink2Color">#58534A</Color>
    <Color x:Key="Atlas.Ink3Color">#696459</Color>
    <Color x:Key="Atlas.LineColor">#DDD8CC</Color>
    <Color x:Key="Atlas.Line2Color">#B8B1A3</Color>
    <Color x:Key="Atlas.HoverColor">#0D1F1D1A</Color>
    <Color x:Key="Atlas.SelColor">#141E7A46</Color>
    <Color x:Key="Atlas.AccentTintColor">#1F1E7A46</Color>
    <Color x:Key="Atlas.AccentSoftColor">#141E7A46</Color>
    <Color x:Key="Atlas.OnAccentColor">#FFFFFF</Color>
    <Color x:Key="Atlas.WarmColor">#B86A25</Color>
    <Color x:Key="Atlas.WarmTintColor">#1FB86A25</Color>
    <Color x:Key="Atlas.HitColor">#F9D66B</Color>
    <Color x:Key="Atlas.HitInkColor">#1F1D1A</Color>
    <Color x:Key="Atlas.Surface3Color">#F1EEE7</Color>
    <Color x:Key="Atlas.OkColor">#1E7A46</Color>
    <Color x:Key="Atlas.AccentBorderColor">#991E7A46</Color>
    <SolidColorBrush x:Key="AppStyle.OmniBarBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppStyle.FilterChipBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppStyle.ThemeMiniButtonSelectedBackground" Color="#141E7A46"/>
    <SolidColorBrush x:Key="AppStyle.ThemeMiniButtonSelectedBorderBrush" Color="#1E7A46"/>
    <SolidColorBrush x:Key="AppStyle.ThemeMiniButtonSelectedForeground" Color="#155C34"/>
    <SolidColorBrush x:Key="AppStyle.QueryChipBackground" Color="#FAF8F3"/>
    <SolidColorBrush x:Key="AppStyle.NavSectionBackground" Color="#FAF8F3"/>
    <SolidColorBrush x:Key="AppStyle.NavSectionHeaderBackground" Color="#FAF8F3"/>
    <SolidColorBrush x:Key="AppStyle.NavSectionHeaderBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="AppStyle.PreviewImageBackground" Color="#FAF8F3"/>
    <CornerRadius x:Key="AppStyle.CommandButtonCornerRadius">9</CornerRadius>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonBorderBrush" Color="#CFC9BC"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonHoverBackground" Color="#FAF8F3"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonHoverBorderBrush" Color="#B8B1A3"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonHoverForeground" Color="#1F1D1A"/>
    <SolidColorBrush x:Key="AppStyle.IconButtonHoverBackground" Color="#121F1D1A"/>
    <SolidColorBrush x:Key="AppStyle.IconButtonHoverForeground" Color="#1F1D1A"/>
    <SolidColorBrush x:Key="AppStyle.PreviewCodeBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush"       Color="#1E7A46"/>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"        Color="#1E7A46"/>
    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush"     Color="#155C34"/>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"    Color="#1F1E7A46"/>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#331E7A46"/>

    <!-- Text -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"       Color="#1F1D1A"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#3F3B34"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"     Color="#696459"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"        Color="#29000000"/>
    <SolidColorBrush x:Key="SystemControlForegroundChromeWhiteBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlForegroundChromeHighBrush"     Color="#1F1D1A"/>

    <!-- Accent color resources (some ModernWpf controls bind these directly) -->
    <Color           x:Key="SystemAccentColor">#1E7A46</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#1E7A46"/>

</ResourceDictionary>
