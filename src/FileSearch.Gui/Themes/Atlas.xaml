<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Atlas — the warm "paper" Light theme.

        This overlay maps the Atlas palette onto ModernWpf's SystemControl*
        brush keys so the built-in controls (ComboBox, DatePicker, CheckBox,
        ScrollBar, menus, flyouts) pick up the warm look.

        It also defines the full Atlas.* color token set (matching the
        AppStyles.xaml light defaults) so the three built-in themes stay
        structurally symmetric: anything realized while this theme is active —
        gradient stops, freshly parsed style overlays, late-realized deferred
        resources, custom-theme companion lookups — resolves this theme's
        values instead of whichever theme happened to define the token last.
    -->

    <!-- Window / page background -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F4F1EA"/>

    <!-- Card / panel surfaces -->
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush"    Color="#FFFDF8"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeHighBrush"      Color="#FFFDF8"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush"    Color="#FFFDF8"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush"       Color="#FAF7F0"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"         Color="#FFFDF8"/>

    <!-- List rows / hover -->
    <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush"    Color="#FAF7F0"/>
    <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="#11000000"/>

    <!-- ===== Our surfaces (Atlas.*) — light token set, mirrors AppStyles.xaml ===== -->
    <Color x:Key="Atlas.AccentColor">#2F7D57</Color>
    <Color x:Key="Atlas.Accent2Color">#37926A</Color>
    <Color x:Key="Atlas.PaperColor">#F4F1EA</Color>
    <Color x:Key="Atlas.SurfaceColor">#FFFDF8</Color>
    <Color x:Key="Atlas.Surface2Color">#FAF7F0</Color>
    <Color x:Key="Atlas.SidebarColor">#EDE8DF</Color>
    <Color x:Key="Atlas.InkColor">#23261F</Color>
    <Color x:Key="Atlas.Ink2Color">#5B5F54</Color>
    <Color x:Key="Atlas.Ink3Color">#8E9286</Color>
    <Color x:Key="Atlas.LineColor">#17000000</Color>
    <Color x:Key="Atlas.Line2Color">#29000000</Color>
    <Color x:Key="Atlas.HoverColor">#0A23261F</Color>
    <Color x:Key="Atlas.SelColor">#1F2F7D57</Color>
    <Color x:Key="Atlas.AccentTintColor">#1A2F7D57</Color>
    <Color x:Key="Atlas.AccentSoftColor">#0F2F7D57</Color>
    <Color x:Key="Atlas.OnAccentColor">#FFFFFF</Color>
    <Color x:Key="Atlas.WarmColor">#C4722E</Color>
    <Color x:Key="Atlas.WarmTintColor">#1FC4722E</Color>
    <Color x:Key="Atlas.HitColor">#8CFFCE54</Color>
    <Color x:Key="Atlas.HitInkColor">#23261F</Color>
    <Color x:Key="Atlas.Surface3Color">#F1EDE4</Color>
    <Color x:Key="Atlas.OkColor">#2E9E6B</Color>
    <Color x:Key="Atlas.AccentBorderColor">#6B2F7D57</Color>
    <SolidColorBrush x:Key="AppStyle.OmniBarBackground" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="AppStyle.FilterChipBackground" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="AppStyle.ThemeMiniButtonSelectedBackground" Color="#1A2F7D57"/>
    <SolidColorBrush x:Key="AppStyle.ThemeMiniButtonSelectedBorderBrush" Color="#2F7D57"/>
    <SolidColorBrush x:Key="AppStyle.ThemeMiniButtonSelectedForeground" Color="#2F7D57"/>
    <SolidColorBrush x:Key="AppStyle.QueryChipBackground" Color="#FAF7F0"/>
    <SolidColorBrush x:Key="AppStyle.NavSectionBackground" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="AppStyle.NavSectionHeaderBackground" Color="#FAF7F0"/>
    <SolidColorBrush x:Key="AppStyle.NavSectionHeaderBorderBrush" Color="#17000000"/>
    <SolidColorBrush x:Key="AppStyle.PreviewImageBackground" Color="#FAF7F0"/>
    <CornerRadius x:Key="AppStyle.CommandButtonCornerRadius">9</CornerRadius>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonBackground" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonBorderBrush" Color="#29000000"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonHoverBackground" Color="#FAF7F0"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonHoverBorderBrush" Color="#2F7D57"/>
    <SolidColorBrush x:Key="AppStyle.SecondaryButtonHoverForeground" Color="#23261F"/>
    <SolidColorBrush x:Key="AppStyle.IconButtonHoverBackground" Color="#0A23261F"/>
    <SolidColorBrush x:Key="AppStyle.IconButtonHoverForeground" Color="#23261F"/>
    <SolidColorBrush x:Key="AppStyle.PreviewCodeBackground" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush"       Color="#2F7D57"/>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"        Color="#2F7D57"/>
    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush"     Color="#37926A"/>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"    Color="#1F2F7D57"/>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#332F7D57"/>

    <!-- Text -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"       Color="#23261F"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#3F4339"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"     Color="#8E9286"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"        Color="#29000000"/>
    <SolidColorBrush x:Key="SystemControlForegroundChromeWhiteBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlForegroundChromeHighBrush"     Color="#23261F"/>

    <!-- Accent color resources (some ModernWpf controls bind these directly) -->
    <Color           x:Key="SystemAccentColor">#2F7D57</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#2F7D57"/>

</ResourceDictionary>
