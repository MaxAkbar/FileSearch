                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search row: folder | query | file types | Search | options -->
                    <Grid Grid.Row="0" Margin="{DynamicResource AppDensity.SearchRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*" MinWidth="140" MaxWidth="340"/>
                            <ColumnDefinition Width="*" MinWidth="370"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Folder chip: glyph browses, path stays editable, chevron opens places. -->
                        <Border Grid.Column="0" Style="{StaticResource SearchFieldShellStyle}"
                                MaxWidth="340" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding Search.BrowseCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="30" Height="30" Margin="5,0,2,0"
                                        ToolTip="Choose folder" AutomationProperties.Name="Choose folder">
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource LineIconStyle}"/>
                                </Button>
                                <TextBox x:Name="SearchPathBox"
                                         Grid.Column="1"
                                         Text="{Binding Search.SearchPath, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource SearchFieldTextBoxStyle}"
                                         FontFamily="{DynamicResource Atlas.MonoFont}"
                                         FontSize="12.5"
                                         MinWidth="80" MaxWidth="250"
                                         ToolTip="Search location — edit or pick a folder"
                                         AutomationProperties.Name="Folder to search"
                                         ui:ControlHelper.PlaceholderText="Folder to search"/>
                                <ToggleButton x:Name="FolderMenuButton" Grid.Column="2"
                                              Style="{StaticResource InlineToggleButtonStyle}"
                                              Margin="2,0,6,0"
                                              ToolTip="Locations and recent folders"
                                              AutomationProperties.Name="Locations and recent folders">
                                    <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.4"/>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=FolderMenuButton}"
                                       IsOpen="{Binding IsChecked, ElementName=FolderMenuButton, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                    <Border Style="{StaticResource DropdownCardStyle}" Width="330"
                                            Tag="{Binding ElementName=FolderMenuButton}"
                                            ButtonBase.Click="OnDropdownItemClick">
                                        <StackPanel>
                                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
                                                <StackPanel>
                                                    <TextBlock Text="LOCATIONS" Style="{StaticResource MenuSectionLabelStyle}"
                                                               Visibility="{Binding History.LocationList.HasContent, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ItemsControl ItemsSource="{Binding History.Locations}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.Search.UseLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource MenuRowButtonStyle}"
                                                                        ToolTip="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                                        <TextBlock Text="{Binding}" FontFamily="{DynamicResource Atlas.MonoFont}" FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="270" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="RECENT FOLDERS" Style="{StaticResource MenuSectionLabelStyle}"
                                                               Visibility="{Binding History.RecentPathList.HasContent, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ItemsControl ItemsSource="{Binding History.RecentPaths}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.Search.UseLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource MenuRowButtonStyle}"
                                                                        ToolTip="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="{StaticResource Icon.Clock}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                                        <TextBlock Text="{Binding}" FontFamily="{DynamicResource Atlas.MonoFont}" FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="270" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                            <Border Height="1" Background="{DynamicResource Atlas.LineBrush}" Margin="4,6"/>
                                            <Button Command="{Binding Search.BrowseCommand}" Style="{StaticResource MenuRowButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                    <TextBlock Text="Browse for a folder…" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding Search.PinSearchFolderCommand}" Style="{StaticResource MenuRowButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                    <TextBlock Text="Pin this folder to locations" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding Index.AddCurrentFolderToIndexCommand}" Style="{StaticResource MenuRowButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Database}" Style="{StaticResource SidebarRowIconStyle}" StrokeThickness="1.2"/>
                                                    <TextBlock Text="Add this folder to the index" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- Query box with inline match toggles. -->
                        <Border Grid.Column="1" Style="{StaticResource SearchFieldShellStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIconStyle}"
                                      StrokeThickness="1.5" Margin="12,0,10,0"/>
                                <TextBox x:Name="QueryBox"
                                         Grid.Column="1"
                                         Text="{Binding Search.QueryText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OmniQueryBoxStyle}"
                                         AutomationProperties.Name="Search text"
                                         ui:ControlHelper.PlaceholderText="{Binding Search.QueryPlaceholderText}"/>
                                <Border Grid.Column="2" Style="{StaticResource KbdHintStyle}"
                                        Margin="8,0,4,0"
                                        ToolTip="Press / to focus the search box">
                                    <TextBlock Text="/" Style="{StaticResource KbdHintTextStyle}"/>
                                </Border>
                                <ToggleButton Grid.Column="3" Content="Aa"
                                              IsChecked="{Binding Search.MatchCase}"
                                              Style="{StaticResource InlineToggleButtonStyle}"
                                              ToolTip="Match case"
                                              AutomationProperties.Name="Match case"/>
                                <ToggleButton Grid.Column="4" Content=".*"
                                              IsChecked="{Binding Search.IsRegexMode}"
                                              Style="{StaticResource InlineToggleButtonStyle}"
                                              FontFamily="{DynamicResource Atlas.MonoFont}" FontWeight="Bold"
                                              ToolTip="Use regular expression"
                                              AutomationProperties.Name="Use regular expression"/>
                                <ToggleButton x:Name="SemanticModeButton" Grid.Column="5" Content="Semantic"
                                              IsChecked="{Binding Search.IsSemanticMode}"
                                              Style="{StaticResource InlineToggleButtonStyle}"
                                              Width="72"
                                              ToolTip="Search indexed content by meaning using your local Smart Search model"
                                              AutomationProperties.Name="Semantic search"/>
                                <Border Grid.Column="6" Width="1" Height="20" Margin="6,0,2,0"
                                        Background="{DynamicResource Atlas.LineBrush}"/>
                                <Button Grid.Column="7" Command="{Binding Search.ClearQueryCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28" Margin="0,0,6,0"
                                        ToolTip="Clear search" AutomationProperties.Name="Clear search">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.4"/>
                                </Button>
                                <!-- Search-in-flight underline. -->
                                <ProgressBar Grid.ColumnSpan="8"
                                             IsIndeterminate="{Binding Search.IsSearching}"
                                             Visibility="{Binding Search.IsSearching, Converter={StaticResource BoolToVisibility}}"
                                             Foreground="{DynamicResource Atlas.AccentBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="2"
                                             VerticalAlignment="Bottom"
                                             Margin="8,0,8,0"
                                             IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- File types (scope presets + custom scopes). -->
                        <Grid Grid.Column="2" Margin="8,0,0,0">
                            <ToggleButton x:Name="FileTypesButton"
                                          Style="{StaticResource SearchFieldButtonStyle}"
                                          ToolTip="{Binding Search.FilePatternSummary}"
                                          AutomationProperties.Name="File types">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding History.ActiveScopeText}" MaxWidth="170"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LineIcon14Style}"
                                          StrokeThickness="1.4" Margin="8,0,0,0"
                                          TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=FileTypesButton}"
                                   IsOpen="{Binding IsChecked, ElementName=FileTypesButton, Mode=TwoWay}"
                                   StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                <Border Style="{StaticResource DropdownCardStyle}" Width="320"
                                        Tag="{Binding ElementName=FileTypesButton}"
                                        ButtonBase.Click="OnDropdownItemClick">
                                    <StackPanel>
                                        <TextBlock Text="FILE TYPES" Style="{StaticResource MenuSectionLabelStyle}"/>
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding History.ScopeItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SidebarScopeItem}">
                                                        <Button Command="{Binding DataContext.Search.ApplyFilePatternPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding FileNamePattern}"
                                                                Tag="{Binding IsActive}"
                                                                Style="{StaticResource MenuRowButtonStyle}"
                                                                ToolTip="{Binding Summary}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ui:FontIcon Glyph="{Binding Glyph}" FontSize="13" Margin="0,0,10,0"
                                                                             Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource SidebarRowLabelStyle}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                                           FontFamily="{DynamicResource Atlas.MonoFont}" FontSize="11"
                                                                           FontWeight="Normal"
                                                                           Foreground="{DynamicResource Atlas.Ink3Brush}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="3"
                                                                        Command="{Binding DataContext.History.RemoveCustomScopeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding CustomScope}"
                                                                        Style="{StaticResource SidebarRowActionButtonStyle}"
                                                                        ToolTip="Remove scope" AutomationProperties.Name="Remove scope"
                                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon12Style}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border Height="1" Background="{DynamicResource Atlas.LineBrush}" Margin="4,6"/>
                                        <Button Click="OnAddScopeClick" Style="{StaticResource MenuRowButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                <TextBlock Text="New file-type scope…" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding History.ClearCustomScopesCommand}" Style="{StaticResource MenuRowButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                <TextBlock Text="Clear custom scopes" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Search / Stop. -->
                        <Button Grid.Column="3" Command="{Binding Search.SearchCommand}" IsDefault="True"
                                Margin="8,0,0,0" ToolTip="Start search">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SearchCommandButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search.IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIcon14Style}"
                                      StrokeThickness="1.9" Margin="0,0,8,0"/>
                                <TextBlock Text="Search" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Command="{Binding Search.CancelCommand}" IsCancel="True"
                                Style="{StaticResource SearchCancelButtonStyle}"
                                Margin="8,0,0,0" ToolTip="Stop the running search"
                                Visibility="{Binding Search.IsSearching, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource LineIcon14Style}"
                                      StrokeThickness="1.6" Margin="0,0,8,0"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- More search options (what to search, mode, includes, limits). -->
                        <ToggleButton Grid.Column="4"
                                      IsChecked="{Binding Search.IsSearchOptionsVisible, Mode=TwoWay}"
                                      Style="{StaticResource SearchFieldButtonStyle}"
                                      Width="{DynamicResource AppDensity.SearchFieldHeight}"
                                      Padding="0" Margin="8,0,0,0"
                                      ToolTip="Search options: what to search, matching mode, includes, and limits"
                                      AutomationProperties.Name="More search options">
                            <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource LineIconStyle}"/>
                        </ToggleButton>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Border x:Name="SemanticResultControls" Margin="20,0,20,8"
                                Visibility="{Binding Search.IsSemanticMode, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search.IsSearching}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="Minimum score" Style="{StaticResource MutedValueStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider x:Name="SemanticMinimumScoreSlider" Width="150" Minimum="0" Maximum="1"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Foreground="{DynamicResource Atlas.AccentBrush}"
                                            Value="{Binding Search.SemanticMinimumScore, Mode=TwoWay}"
                                            ToolTip="Higher scores require a closer match. Similarity is model dependent, not a probability. Click Search to apply."
                                            AutomationProperties.Name="Minimum semantic score"/>
                                    <Border Style="{StaticResource SearchFieldShellStyle}" Width="56" Height="28" CornerRadius="5" Padding="5,0" Margin="10,0,0,0">
                                    <TextBox x:Name="SemanticMinimumScoreBox" Style="{StaticResource SearchFieldTextBoxStyle}" FontSize="12.5"
                                             Text="{Binding Search.SemanticMinimumScore, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Minimum similarity from 0.00 to 1.00; 0.00 includes all candidates. Click Search to apply."
                                             AutomationProperties.Name="Minimum semantic score value"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="Maximum files" Style="{StaticResource MutedValueStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Style="{StaticResource SearchFieldShellStyle}" Width="48" Height="28" CornerRadius="5" Padding="5,0">
                                    <TextBox x:Name="SemanticMaximumResultsBox" Style="{StaticResource SearchFieldTextBoxStyle}" FontSize="12.5"
                                             Text="{Binding Search.SemanticMaximumResults, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Return the best 1 to 25 files that meet Minimum score. Click Search to apply."
                                             AutomationProperties.Name="Maximum semantic files"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Click Search to apply" Style="{StaticResource MutedValueStyle}" VerticalAlignment="Center" FontSize="11.5"/>
                            </WrapPanel>
                        </Border>

                    <!-- Interpreted query chips -->
                    <ItemsControl
                                  ItemsSource="{Binding Search.QueryChips}"
                                  Visibility="{Binding Search.HasQueryChips, Converter={StaticResource BoolToVisibility}}"
                                  Margin="20,0,20,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueryChipViewModel}">
                                <Border Style="{StaticResource QueryChipStyle}" ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Field}" Style="{StaticResource QueryChipFieldStyle}"/>
                                        <TextBlock Text=":" Style="{StaticResource QueryChipFieldStyle}" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource OmniQueryBoxStyle}"
                                                 IsEnabled="{Binding IsEnabled}"
                                                 MinWidth="42"
                                                 MaxWidth="220"
                                                 ToolTip="{Binding ToolTip}"/>
                                        <TextBlock Text="Unavailable"
                                                   Style="{StaticResource MutedValueStyle}"
                                                   Margin="8,1,0,0"
                                                   Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Command="{Binding DataContext.Search.RemoveQueryChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="{DynamicResource AppDensity.TinyIconButtonSize}"
                                                Height="{DynamicResource AppDensity.TinyIconButtonSize}"
                                                Padding="0"
                                                Margin="7,0,-2,0"
                                                ToolTip="{Binding ToolTip}">
                                            <ui:FontIcon Glyph="&#xE711;" FontSize="9"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>

                    <!-- Search options (SEARCH IN / MATCH pills, REFINE / INCLUDE chips) -->
                    <Border Grid.Row="2"
                        Margin="20,0,20,12"
                            Style="{StaticResource SearchOptionsPanelStyle}"
                            Visibility="{Binding Search.IsSearchOptionsVisible, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Reset to defaults"
                                        Command="{Binding Search.ResetSearchOptionsCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        FontSize="12"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="Size, date and file-type limits live under Advanced"
                                           Style="{StaticResource MutedValueStyle}"
                                           FontSize="11.5"
                                           Margin="0,0,14,0"/>
                                <Button Grid.Column="3"
                                        Command="{Binding Search.HideSearchOptionsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Done"/>
                            </Grid>
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="SEARCH IN" Style="{StaticResource OptionGroupLabelStyle}"/>
                                        <ItemsControl ItemsSource="{Binding Search.SearchTargetOptions}"
                                                      Margin="0,0,0,2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SearchTargetOption}">
                                                    <CheckBox Content="{Binding DisplayName}"
                                                              IsChecked="{Binding IsSelected}"
                                                              Style="{StaticResource CheckChipStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MATCH" Style="{StaticResource OptionGroupLabelStyle}"/>
                                        <ListBox ItemsSource="{Binding Search.AvailableModes}"
                                                 SelectedItem="{Binding Search.SearchMode}"
                                                 Style="{StaticResource ResultOptionPickerStyle}"
                                                 Margin="0,0,0,2"
                                                 ItemContainerStyle="{StaticResource ResultOptionPickerItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="REFINE" Style="{StaticResource OptionGroupLabelStyle}"/>
                                <WrapPanel>
                                    <CheckBox Content="Match case"
                                              IsChecked="{Binding Search.MatchCase}"
                                              Style="{StaticResource CheckChipStyle}"/>
                                </WrapPanel>

                                <TextBlock Text="INCLUDE" Style="{StaticResource OptionGroupLabelStyle}"/>
                                <WrapPanel>
                                    <CheckBox Content="Subfolders"
                                              IsChecked="{Binding Search.IncludeSubfolders}"
                                              Style="{StaticResource CheckChipStyle}"/>
                                    <CheckBox Content="Office &amp; PDF text"
                                              IsChecked="{Binding Search.EnableDocumentExtraction}"
                                              Style="{StaticResource CheckChipStyle}"/>
                                    <CheckBox Content="Text in images (OCR)"
                                              IsChecked="{Binding Search.EnableImageOcr}"
                                              ToolTip="Extract text from PNG, JPEG, BMP, and TIFF images."
                                              Style="{StaticResource CheckChipStyle}"/>
                                    <CheckBox Content="Use index"
                                              IsChecked="{Binding Search.UseIndex}"
                                              Style="{StaticResource CheckChipStyle}"/>
                                </WrapPanel>

                                <Expander Header="Advanced" Style="{StaticResource AdvancedExpanderStyle}" Margin="0,6,8,0">
                            <Border Style="{StaticResource AdvancedFlyoutCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FILE SIZE (KB)" Style="{StaticResource SectionHeaderStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Min" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Text="{Binding Search.MinSizeKB}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Max" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Text="{Binding Search.MaxSizeKB}" ToolTip="0 = no upper limit"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MODIFIED" Style="{StaticResource SectionHeaderStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox Content="After" IsChecked="{Binding Search.ModifiedAfterEnabled}"/>
                                                <DatePicker SelectedDate="{Binding Search.ModifiedAfter}"
                                                            IsEnabled="{Binding Search.ModifiedAfterEnabled}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <CheckBox Content="Before" IsChecked="{Binding Search.ModifiedBeforeEnabled}"/>
                                                <DatePicker SelectedDate="{Binding Search.ModifiedBefore}"
                                                            IsEnabled="{Binding Search.ModifiedBeforeEnabled}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="FILE TYPES" Style="{StaticResource SectionHeaderStyle}"/>
                                        <CheckBox Content="{Binding Search.UnknownFileTypesSummary}"
                                                  IsChecked="{Binding Search.SkipUnknownFileTypes}"
                                                  ToolTip="Faster, but extensionless or uncommon text files are not searched."/>
                                        <TextBlock Text="Additional plain-text extensions"
                                                   Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                                        <TextBox Text="{Binding Search.AdditionalPlainTextExtensions, UpdateSourceTrigger=PropertyChanged}"
                                                 ui:ControlHelper.PlaceholderText=".liquid; .tmpl; .foo"/>
                                        <TextBlock Text="Separate extensions with commas or semicolons."
                                                   Style="{StaticResource HintLabelStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                                </Expander>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Results header: "1,057 matches in 199 files" + toolbar -->
                    <Grid Grid.Row="3"
                          Margin="{DynamicResource AppDensity.ResultsHeaderMargin}"
                          MinHeight="{DynamicResource AppDensity.ResultsHeaderMinHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Search.ResultsHeadlineText}"
                                       Style="{StaticResource ResultsHeadlineStyle}"
                                       MaxWidth="380"
                                       ToolTip="{Binding Search.ResultsContextText}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Search.ResultsSublineText}"
                                       Style="{StaticResource ResultsSublineStyle}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,3,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Search.IsSearching, Converter={StaticResource BoolToVisibility}}">
                                <ui:ProgressRing IsActive="{Binding Search.IsSearching}"
                                                 Width="14" Height="14"
                                                 MinWidth="14" MinHeight="14"
                                                 Foreground="{DynamicResource Atlas.AccentBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="Searching…"
                                           Style="{StaticResource MutedValueStyle}"
                                           Foreground="{DynamicResource Atlas.AccentBrush}"
                                           Margin="7,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- In-memory filter over the results ("search the search"). -->
                            <Grid Width="230" Margin="12,0,0,0">
                                <TextBox Text="{Binding Search.RefinementQuery, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                         Style="{StaticResource SidebarFilterBoxStyle}"
                                         MinHeight="{DynamicResource AppDensity.ToolbarButtonHeight}"
                                         ui:ControlHelper.PlaceholderText="Filter results by name or path"
                                         AutomationProperties.Name="Filter results"/>
                                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIcon14Style}"
                                      HorizontalAlignment="Left" Margin="8,0,0,0"
                                      TextElement.Foreground="{DynamicResource Atlas.Ink3Brush}"/>
                                <Button Command="{Binding Search.ClearRefinementCommand}"
                                        Style="{StaticResource SidebarMiniButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,0,4,0"
                                        ToolTip="Clear filter" AutomationProperties.Name="Clear filter">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon12Style}"/>
                                </Button>
                            </Grid>

                            <ToggleButton IsChecked="{Binding Search.IsResultFiltersVisible, Mode=TwoWay}"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          ToolTip="Filter results by type, folder, date, size, source, and name">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Funnel}" Style="{StaticResource ToolbarIconStyle}"
                                          TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                    <TextBlock Text="Filters" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource ResultFilterBadgeStyle}" Margin="6,0,0,0"
                                            Visibility="{Binding Search.HasActiveResultFacets, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Search.ActiveResultFacetCount}"
                                                   Foreground="{DynamicResource Atlas.OnAccentBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LineIcon14Style}"
                                          StrokeThickness="1.4" Margin="6,0,0,0"
                                          TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- View: grouping, sort, and card layout. -->
                            <Grid>
                                <ToggleButton x:Name="ViewMenuButton"
                                              Style="{StaticResource ToolbarToggleButtonStyle}"
                                              ToolTip="Group, sort, and lay out results"
                                              AutomationProperties.Name="View options">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Lines}" Style="{StaticResource ToolbarIconStyle}"
                                              TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                        <TextBlock Text="View" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Search.ResultViewButtonText}" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Atlas.Ink2Brush}" VerticalAlignment="Center"/>
                                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LineIcon14Style}"
                                              StrokeThickness="1.4" Margin="6,0,0,0"
                                              TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=ViewMenuButton}"
                                       IsOpen="{Binding IsChecked, ElementName=ViewMenuButton, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                    <Border Style="{StaticResource DropdownCardStyle}" Width="250">
                                        <StackPanel>
                                            <TextBlock Text="GROUP BY" Style="{StaticResource MenuSectionLabelStyle}"/>
                                            <ListBox ItemsSource="{Binding Search.ResultGroupOptions}"
                                                     SelectedItem="{Binding Search.SelectedGroupOption}"
                                                     Style="{StaticResource FilterMenuListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ResultGroupOption}">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FilterMenuOptionLabelStyle}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="SORT BY" Style="{StaticResource MenuSectionLabelStyle}"/>
                                            <ListBox ItemsSource="{Binding Search.ResultSortOptions}"
                                                     SelectedItem="{Binding Search.SelectedSortOption}"
                                                     Style="{StaticResource FilterMenuListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ResultSortOption}">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FilterMenuOptionLabelStyle}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="LAYOUT" Style="{StaticResource MenuSectionLabelStyle}"/>
                                            <Button Command="{Binding Search.SetComfortableResultLayoutCommand}"
                                                    Tag="{Binding Search.IsComfortableResultLayout}"
                                                    Style="{StaticResource MenuRowButtonStyle}"
                                                    ToolTip="Show matching lines under each result">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:FontIcon Glyph="&#xE9E9;" FontSize="12" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Comfortable — show matching lines" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding Search.SetCompactResultLayoutCommand}"
                                                    Tag="{Binding Search.IsCompactResultLayout}"
                                                    Style="{StaticResource MenuRowButtonStyle}"
                                                    ToolTip="One line per result">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:FontIcon Glyph="&#xE8FD;" FontSize="12" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Compact — one line per file" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding Search.ResultArrangementSummaryText}"
                                                       Style="{StaticResource MutedValueStyle}"
                                                       FontSize="11.5" Margin="8,8,8,2"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Border Style="{StaticResource ToolbarDividerStyle}"/>

                            <Button Command="{Binding Search.CopyGroundedAnswerCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="Copy a grounded answer draft with citations">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Chat}" Style="{StaticResource ToolbarIconStyle}"
                                          TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                    <TextBlock Text="Answer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnExportMenuButtonClick"
                                    ToolTip="Export visible results">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom"
                                                 DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="CSV" Command="{Binding Search.ExportResultsCommand}" CommandParameter="csv"/>
                                        <MenuItem Header="JSON" Command="{Binding Search.ExportResultsCommand}" CommandParameter="json"/>
                                        <MenuItem Header="JSON Lines" Command="{Binding Search.ExportResultsCommand}" CommandParameter="jsonl"/>
                                        <MenuItem Header="Markdown" Command="{Binding Search.ExportResultsCommand}" CommandParameter="markdown"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Export}" Style="{StaticResource ToolbarIconStyle}"
                                          TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                    <TextBlock Text="Export" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LineIcon14Style}"
                                          StrokeThickness="1.4" Margin="6,0,0,0"
                                          TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Search.TogglePreviewPaneCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="{DynamicResource AppDensity.ToolbarButtonHeight}" Padding="0"
                                    ToolTip="Show the preview pane" AutomationProperties.Name="Show preview"
                                    Visibility="{Binding Search.IsPreviewPaneVisible, Converter={StaticResource InverseBoolToVisibility}}">
                                <Path Data="{StaticResource Icon.PreviewToggle}" Style="{StaticResource LineIconStyle}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Filters bar: compact dropdowns whose menus overlay the results. -->
                    <Border Grid.Row="4" Margin="20,0,20,8" Style="{StaticResource ResultOptionsPanelStyle}"
                            Padding="10,9"
                            Visibility="{Binding Search.IsResultFiltersVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <Grid>
                                    <ToggleButton x:Name="TypeFilterButton"
                                                  Style="{StaticResource FilterDropButtonStyle}"
                                                  Tag="{Binding Search.HasFileTypeFacetSelection}">
                                        <TextBlock Text="{Binding Search.FileTypeFacetButtonText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=TypeFilterButton}"
                                           IsOpen="{Binding IsChecked, ElementName=TypeFilterButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                        <Border Style="{StaticResource FilterMenuCardStyle}" Width="230">
                                            <ListBox ItemsSource="{Binding Search.FileTypeFacetOptions}"
                                                     SelectedItem="{Binding Search.SelectedFileTypeFacet}"
                                                     Style="{StaticResource FilterMenuListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ResultFacetOption}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FilterMenuOptionLabelStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:n0}}" Style="{StaticResource FilterMenuOptionCountStyle}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid>
                                    <ToggleButton x:Name="FolderFilterButton"
                                                  Style="{StaticResource FilterDropButtonStyle}"
                                                  Tag="{Binding Search.HasFolderFacetSelection}">
                                        <TextBlock Text="{Binding Search.FolderFacetButtonText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=FolderFilterButton}"
                                           IsOpen="{Binding IsChecked, ElementName=FolderFilterButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                        <Border Style="{StaticResource FilterMenuCardStyle}" Width="290">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Top" Style="{StaticResource FilterMenuInputRowStyle}">
                                                    <DockPanel LastChildFill="True">
                                                        <ui:FontIcon DockPanel.Dock="Left" Glyph="&#xE721;" FontSize="11"
                                                                     Foreground="{DynamicResource Atlas.Ink3Brush}"
                                                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding Search.FolderFacetFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FilterMenuInputBoxStyle}"
                                                                 FontFamily="{DynamicResource Atlas.SansFont}"
                                                                 FontSize="12"
                                                                 ui:ControlHelper.PlaceholderText="Filter folders…"/>
                                                    </DockPanel>
                                                </Border>
                                                <ListBox ItemsSource="{Binding Search.FilteredFolderFacetOptions}"
                                                         SelectedItem="{Binding Search.SelectedFolderFacet}"
                                                         Style="{StaticResource FilterMenuListBoxStyle}"
                                                         ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ResultFacetOption}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}"
                                                                           Style="{StaticResource FilterMenuOptionLabelStyle}"
                                                                           FontFamily="{DynamicResource Atlas.MonoFont}"
                                                                           FontSize="12"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:n0}}" Style="{StaticResource FilterMenuOptionCountStyle}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid>
                                    <ToggleButton x:Name="DateFilterButton"
                                                  Style="{StaticResource FilterDropButtonStyle}"
                                                  Tag="{Binding Search.HasModifiedFacetSelection}">
                                        <TextBlock Text="{Binding Search.ModifiedFacetButtonText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=DateFilterButton}"
                                           IsOpen="{Binding IsChecked, ElementName=DateFilterButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                        <Border Style="{StaticResource FilterMenuCardStyle}" Width="200">
                                            <ListBox ItemsSource="{Binding Search.ModifiedFacetOptions}"
                                                     SelectedItem="{Binding Search.SelectedModifiedFacet}"
                                                     Style="{StaticResource FilterMenuListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ResultFacetOption}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FilterMenuOptionLabelStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:n0}}" Style="{StaticResource FilterMenuOptionCountStyle}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid>
                                    <ToggleButton x:Name="SizeFilterButton"
                                                  Style="{StaticResource FilterDropButtonStyle}"
                                                  Tag="{Binding Search.HasSizeFacetSelection}">
                                        <TextBlock Text="{Binding Search.SizeFacetButtonText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=SizeFilterButton}"
                                           IsOpen="{Binding IsChecked, ElementName=SizeFilterButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                        <Border Style="{StaticResource FilterMenuCardStyle}" Width="210">
                                            <ListBox ItemsSource="{Binding Search.SizeFacetOptions}"
                                                     SelectedItem="{Binding Search.SelectedSizeFacet}"
                                                     Style="{StaticResource FilterMenuListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ResultFacetOption}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FilterMenuOptionLabelStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:n0}}" Style="{StaticResource FilterMenuOptionCountStyle}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid>
                                    <ToggleButton x:Name="SourceFilterButton"
                                                  Style="{StaticResource FilterDropButtonStyle}"
                                                  Tag="{Binding Search.HasSourceFacetSelection}">
                                        <TextBlock Text="{Binding Search.SourceFacetButtonText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=SourceFilterButton}"
                                           IsOpen="{Binding IsChecked, ElementName=SourceFilterButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                        <Border Style="{StaticResource FilterMenuCardStyle}" Width="190">
                                            <ListBox ItemsSource="{Binding Search.SourceFacetOptions}"
                                                     SelectedItem="{Binding Search.SelectedSourceFacet}"
                                                     Style="{StaticResource FilterMenuListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource FilterMenuItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ResultFacetOption}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FilterMenuOptionLabelStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:n0}}" Style="{StaticResource FilterMenuOptionCountStyle}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid>
                                    <ToggleButton x:Name="NameFilterButton"
                                                  Style="{StaticResource FilterDropButtonStyle}"
                                                  Tag="{Binding Search.HasNameFilterSelection}"
                                                  ToolTip="Include / exclude file name patterns">
                                        <TextBlock Text="{Binding Search.NameFilterButtonText}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=NameFilterButton}"
                                           IsOpen="{Binding IsChecked, ElementName=NameFilterButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                        <Border Style="{StaticResource FilterMenuCardStyle}" Width="290">
                                            <StackPanel Margin="4">
                                                <Border Style="{StaticResource FilterMenuInputRowStyle}">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="Include" Width="48"
                                                                   FontSize="11" Foreground="{DynamicResource Atlas.Ink3Brush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding Search.FileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FilterMenuInputBoxStyle}"
                                                                 ui:ControlHelper.PlaceholderText="*.*"/>
                                                    </DockPanel>
                                                </Border>
                                                <Border Style="{StaticResource FilterMenuInputRowStyle}">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="Exclude" Width="48"
                                                                   FontSize="11" Foreground="{DynamicResource Atlas.Ink3Brush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding Search.ExcludeFileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FilterMenuInputBoxStyle}"
                                                                 ui:ControlHelper.PlaceholderText="*.log;*.tmp"/>
                                                    </DockPanel>
                                                </Border>
                                                <TextBlock Text="Separate patterns with ;"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Atlas.Ink3Brush}"
                                                           Margin="2,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </WrapPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding Search.ClearResultFacetsCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Content="Clear all"/>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="5" Margin="20,0,20,8"
                               Visibility="{Binding Search.HasActiveResultFacets, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ACTIVE" Style="{StaticResource FilterStripLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding Search.ActiveResultFacetChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ResultFacetChip}">
                                    <Border Style="{StaticResource ActiveFacetChipStyle}" ToolTip="{Binding ToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Field}" Style="{StaticResource ActiveFacetFieldStyle}"/>
                                            <TextBlock Text=":" Style="{StaticResource ActiveFacetFieldStyle}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource ActiveFacetValueStyle}"/>
                                            <Button Command="{Binding DataContext.Search.ClearResultFacetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Key}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="{DynamicResource AppDensity.TinyIconButtonSize}"
                                                    Height="{DynamicResource AppDensity.TinyIconButtonSize}"
                                                    Padding="0"
                                                    Margin="6,0,-2,0"
                                                    ToolTip="{Binding ClearToolTip}">
                                                <ui:FontIcon Glyph="&#xE711;" FontSize="9"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding Search.ClearResultFacetsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,5"
                                Content="Clear all"/>
                    </WrapPanel>

                    <!-- Results | splitter | preview -->
                    <Grid x:Name="ResultsArea" Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ContentColumn" Width="*" MinWidth="420"/>
                            <ColumnDefinition x:Name="PreviewSplitterColumn" Width="Auto"/>
                            <ColumnDefinition x:Name="PreviewColumn" Width="{DynamicResource AppDensity.PreviewColumnWidth}" MinWidth="300" MaxWidth="720"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="{DynamicResource AppDensity.ResultsListMargin}">
                            <!-- Keep CanContentScroll local: the theme's grouping trigger
                                 overrides style setters and otherwise disables virtualization. -->
                            <controls:ResultsListBox x:Name="ResultsList"
                                     ItemsSource="{Binding Search.FilesView}"
                                     SelectedItem="{Binding Search.SelectedFile}"
                                     Style="{StaticResource ResultsListStyle}"
                                     Padding="{DynamicResource AppDensity.SearchResultsListPadding}"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.CacheLength="0"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     AutomationProperties.Name="Results"
                                     PreviewMouseMove="OnResultsPreviewMouseMove">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <!-- Avoid a collapsed first measure before the
                                                                 recycled group's state binding resolves. -->
                                                            <Expander Style="{StaticResource ResultGroupExpanderStyle}" Margin="0,2,10,2"
                                                                      IsExpanded="{Binding Tag.IsExpanded, RelativeSource={RelativeSource Self}, Mode=TwoWay, FallbackValue=True}">
                                                                <Expander.Tag>
                                                                    <MultiBinding Converter="{StaticResource ResultGroupState}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.Search" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                    </MultiBinding>
                                                                </Expander.Tag>
                                                                <Expander.Header>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource LineIconStyle}"
                                                                              Margin="0,0,8,0"
                                                                              Visibility="{Binding DataContext.Search.IsGroupedByFolder, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                                   FontFamily="{DynamicResource Atlas.MonoFont}"
                                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Atlas.InkBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip="{Binding Name}"/>
                                                                        <Border Grid.Column="2" Height="1" Margin="10,1,10,0"
                                                                                Background="{DynamicResource Atlas.LineBrush}"
                                                                                VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" FontSize="12"
                                                                                   Foreground="{DynamicResource Atlas.Ink2Brush}"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Text>
                                                                                <Binding Path="Tag.SummaryText" RelativeSource="{RelativeSource AncestorType=Expander}"/>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Expander.Header>
                                                                <ItemsPresenter/>
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ResultCardContainerStyle}">
                                        <EventSetter Event="MouseDoubleClick" Handler="OnResultCardDoubleClick"/>
                                        <Setter Property="Margin" Value="{DynamicResource AppDensity.SearchResultCardMargin}"/>
                                        <Setter Property="Tag" Value="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="_Open" Command="{Binding OpenCommand}" InputGestureText="Enter">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8E5;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Open OCR _preview"
                                                              Command="{Binding OpenImageOcrPreviewCommand}"
                                                              Visibility="{Binding HasImageOcrPreview, Converter={StaticResource BoolToVisibility}}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8A5;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="_Reveal in Explorer" Command="{Binding RevealInExplorerCommand}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE838;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="_Rename..."
                                                              Command="{Binding PlacementTarget.Tag.RenameResultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8AC;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Move to _Recycle Bin"
                                                              Command="{Binding PlacementTarget.Tag.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE74D;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Copy file _path" Command="{Binding CopyPathCommand}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8C8;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy _folder path" Command="{Binding CopyFolderPathCommand}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8C8;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding PinActionText}"
                                                              Command="{Binding PlacementTarget.Tag.TogglePinResultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="{Binding PinGlyph}" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding FavoriteActionText}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleFavoriteResultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding ExcludeExtensionPatternMenuText}"
                                                              Command="{Binding PlacementTarget.Tag.ExcludeFileExtensionPatternCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE74D;" FontSize="14"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileResultViewModel}">
                                        <StackPanel>
                                            <!-- card head: badge, name (+ folder when not grouped by folder), actions, count -->
                                            <Grid Margin="{DynamicResource AppDensity.ResultCardInnerMargin}" MinHeight="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <Border Style="{StaticResource SoftTypeBadgeStyle}"
                                                            Background="{Binding FileName, Converter={StaticResource TypeTint}}">
                                                        <TextBlock Text="{Binding FileName, Converter={StaticResource TypeLabel}}"
                                                                   Style="{StaticResource SoftTypeBadgeTextStyle}"
                                                                   Foreground="{Binding FileName, Converter={StaticResource TypeInk}}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource NeutralTypeBadgeStyle}">
                                                        <TextBlock Text="{Binding FileName, Converter={StaticResource TypeLabel}}"
                                                                   Style="{StaticResource TypeBadgeNeutralTextStyle}"
                                                                   FontSize="10"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ResultCardNameStyle}"
                                                                   DockPanel.Dock="Left" ToolTip="{Binding FullPath}"/>
                                                        <TextBlock Text="{Binding DisplayDirectory}"
                                                                   FontFamily="{DynamicResource Atlas.MonoFont}" FontSize="11"
                                                                   Foreground="{DynamicResource Atlas.Ink3Brush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" Margin="10,2,0,0"
                                                                   Visibility="{Binding DataContext.Search.IsGroupedByFolder, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding MailSummaryText}" FontSize="11"
                                                               Foreground="{DynamicResource Atlas.Ink3Brush}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasMailMessage, Converter={StaticResource BoolToVisibility}}"/>
                                                    <WrapPanel Visibility="{DynamicResource AppStyle.ResultMetadataVisibility}">
                                                        <Border Style="{DynamicResource ResultMetaPillStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="src" Style="{DynamicResource ResultMetaKeyStyle}"/>
                                                                <TextBlock Text="{Binding SourceGroup}" Style="{DynamicResource ResultMetaValueStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{DynamicResource ResultMetaPillStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="mod" Style="{DynamicResource ResultMetaKeyStyle}"/>
                                                                <TextBlock Text="{Binding ModifiedText}" Style="{DynamicResource ResultMetaValueStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{DynamicResource ResultMetaPillStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="size" Style="{DynamicResource ResultMetaKeyStyle}"/>
                                                                <TextBlock Text="{Binding SizeText}" Style="{DynamicResource ResultMetaValueStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Style="{StaticResource ResultCardActionsStyle}">
                                                    <Button Command="{Binding DataContext.Search.ToggleFavoriteResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsFavorite}"
                                                            Style="{StaticResource ResultCardIconButtonStyle}"
                                                            ToolTip="{Binding FavoriteActionText}">
                                                        <ui:FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="13"
                                                                     Style="{StaticResource FavoriteResultGlyphStyle}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.Search.TogglePinResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsPinned}"
                                                            Style="{StaticResource ResultCardIconButtonStyle}"
                                                            ToolTip="{Binding PinActionText}">
                                                        <ui:FontIcon Glyph="{Binding PinGlyph}" FontSize="13"
                                                                     Style="{StaticResource PinResultGlyphStyle}"/>
                                                    </Button>
                                                </StackPanel>
                                                <Border Grid.Column="3" Style="{StaticResource HitsPillStyle}" Margin="4,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MatchCountText}" FontFamily="{DynamicResource Atlas.SansFont}" FontSize="11.5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource HitsPillTextStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.Search.HasSemanticResults, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding BestScore, StringFormat='Score {0:F2}'}" Style="{StaticResource HitsPillTextStyle}"
                                                                   FontFamily="{DynamicResource Atlas.SansFont}" FontSize="11.5"
                                                                   ToolTip="Semantic similarity score; higher is more relevant. This is not a probability."
                                                                   Visibility="{Binding DataContext.Search.HasSemanticResults, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- matching lines (hidden in the compact result layout) -->
                                            <StackPanel Visibility="{Binding DataContext.Search.IsComfortableResultLayout, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                                <Border Style="{DynamicResource ResultHitsPanelStyle}">
                                                    <ItemsControl ItemsSource="{Binding VisibleHits}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{DynamicResource MatchLineContainerStyle}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding LineNumber}" Style="{StaticResource LineNoStyle}"/>
                                                                        <TextBlock Grid.Column="1" Style="{StaticResource LineTextStyle}"
                                                                                   hl:HitHighlight.Hit="{Binding}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <Button Command="{Binding ToggleExpandCommand}"
                                                        Content="{Binding MoreText}"
                                                        Style="{StaticResource MoreLinkStyle}"
                                                        Visibility="{Binding HasMoreHits, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </controls:ResultsListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Search.Files.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIconStyle}"
                                      Opacity="0.3" Margin="0,0,0,14">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleX="2.5" ScaleY="2.5"/>
                                    </Path.LayoutTransform>
                                </Path>
                                <TextBlock Text="No results yet" Style="{StaticResource EmptyTitleStyle}"/>
                                <TextBlock Text="Enter a query and press Search. Matches appear here grouped by folder, with the matching lines highlighted."
                                           Style="{StaticResource EmptyBodyStyle}"/>
                            </StackPanel>
                        </Grid>

                        <GridSplitter Grid.Column="1" Style="{StaticResource PreviewGridSplitterStyle}"
                                      DragDelta="OnPreviewSplitterDragDelta"/>

                        <!-- ===== Preview card ===== -->
                        <Grid Grid.Column="2"
                              Margin="{DynamicResource AppDensity.PreviewCardMargin}"
                              Visibility="{Binding Search.IsPreviewPaneVisible, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource PreviewCardShadowStyle}"/>
                            <Border Style="{StaticResource PreviewCardStyle}" ClipToBounds="True">
                                <Grid>
                                    <!-- selected file -->
                                    <DockPanel Visibility="{Binding Search.HasSelectedFile, Converter={StaticResource BoolToVisibility}}">
                                        <!-- identity -->
                                        <Grid DockPanel.Dock="Top" Margin="16,14,12,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid VerticalAlignment="Center">
                                                <Border Style="{StaticResource SoftTypeBadgeStyle}" Width="38" Height="28" CornerRadius="5"
                                                        Background="{Binding Search.SelectedFile.FileName, Converter={StaticResource TypeTint}}">
                                                    <TextBlock Text="{Binding Search.SelectedFile.FileName, Converter={StaticResource TypeLabel}}"
                                                               Style="{StaticResource SoftTypeBadgeTextStyle}" FontSize="12"
                                                               Foreground="{Binding Search.SelectedFile.FileName, Converter={StaticResource TypeInk}}"/>
                                                </Border>
                                                <Border Style="{StaticResource NeutralTypeBadgeStyle}" Width="38" Height="28" CornerRadius="5">
                                                    <TextBlock Text="{Binding Search.SelectedFile.FileName, Converter={StaticResource TypeLabel}}"
                                                               Style="{StaticResource TypeBadgeNeutralTextStyle}" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Search.SelectedFile.FileName}" Style="{StaticResource PreviewTitleStyle}"
                                                           ToolTip="{Binding Search.SelectedFile.FullPath}"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Atlas.Ink2Brush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           ToolTip="{Binding Search.SelectedFile.FullPath}">
                                                    <Run Text="{Binding Search.SelectedFile.Directory, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Search.SelectedFile.SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Search.SelectedFile.ModifiedText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Search.SelectedFile.SourceGroup, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Command="{Binding Search.SelectedFile.OpenImageOcrPreviewCommand}"
                                                        Visibility="{Binding Search.SelectedFile.HasImageOcrPreview, Converter={StaticResource BoolToVisibility}}"
                                                        Style="{StaticResource PreviewNavButtonStyle}" Width="28" Height="28"
                                                        ToolTip="Open OCR preview" AutomationProperties.Name="Open OCR preview">
                                                    <Path Data="{StaticResource Icon.Image}" Style="{StaticResource LineIconStyle}"/>
                                                </Button>
                                                <Button Command="{Binding Search.ToggleFavoriteResultCommand}"
                                                        CommandParameter="{Binding Search.SelectedFile}"
                                                        Style="{StaticResource PreviewNavButtonStyle}" Width="28" Height="28"
                                                        ToolTip="{Binding Search.SelectedFile.FavoriteActionText}">
                                                    <ui:FontIcon Glyph="{Binding Search.SelectedFile.FavoriteGlyph}" FontSize="14">
                                                        <ui:FontIcon.Style>
                                                            <Style TargetType="ui:FontIcon">
                                                                <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Search.SelectedFile.IsFavorite}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Atlas.WarmBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:FontIcon.Style>
                                                    </ui:FontIcon>
                                                </Button>
                                                <Button Command="{Binding Search.TogglePreviewPaneCommand}"
                                                        Style="{StaticResource PreviewNavButtonStyle}" Width="28" Height="28"
                                                        Foreground="{DynamicResource Atlas.Ink2Brush}"
                                                        ToolTip="Hide preview" AutomationProperties.Name="Hide preview">
                                                    <Path Data="{StaticResource Icon.PreviewToggle}" Style="{StaticResource LineIconStyle}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- match navigator -->
                                        <Border DockPanel.Dock="Top" Style="{StaticResource PreviewBandStyle}"
                                                BorderThickness="0,1,0,1" MinHeight="36" Padding="16,0,10,0"
                                                Visibility="{Binding Search.HasPreviewLines, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Search.PreviewMatchPositionText}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Search.PreviewCurrentLineText}" FontSize="12"
                                                           Foreground="{DynamicResource Atlas.Ink2Brush}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Command="{Binding Search.PreviousPreviewMatchCommand}"
                                                        Style="{StaticResource PreviewNavButtonStyle}"
                                                        ToolTip="Previous match" AutomationProperties.Name="Previous match">
                                                    <Path Data="{StaticResource Icon.ArrowUp}" Style="{StaticResource LineIconStyle}" StrokeThickness="1.4"/>
                                                </Button>
                                                <Button Grid.Column="4" Command="{Binding Search.NextPreviewMatchCommand}"
                                                        Style="{StaticResource PreviewNavButtonStyle}"
                                                        ToolTip="Next match" AutomationProperties.Name="Next match">
                                                    <Path Data="{StaticResource Icon.ArrowDown}" Style="{StaticResource LineIconStyle}" StrokeThickness="1.4"/>
                                                </Button>
                                                <Border Grid.Column="5" Width="1" Height="18" Margin="8,0,6,0"
                                                        Background="{DynamicResource Atlas.LineBrush}"/>
                                                <ToggleButton Grid.Column="6" IsChecked="{Binding Search.IsPreviewWrapEnabled}"
                                                              Style="{StaticResource InlineToggleButtonStyle}"
                                                              Width="26" Height="26"
                                                              ToolTip="Wrap long lines" AutomationProperties.Name="Wrap long lines">
                                                    <Path Data="{StaticResource Icon.Wrap}" Style="{StaticResource LineIconStyle}"/>
                                                </ToggleButton>
                                            </Grid>
                                        </Border>

                                        <!-- actions -->
                                        <Border DockPanel.Dock="Bottom" Style="{StaticResource PreviewBandStyle}"
                                                BorderThickness="0,1,0,0" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding Search.OpenPreviewTargetCommand}"
                                                        Style="{StaticResource PreviewPrimaryButtonStyle}"
                                                        ToolTip="Open the file at the current match">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.OpenExternal}" Style="{StaticResource LineIconStyle}"
                                                              StrokeThickness="1.4" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Search.OpenPreviewTargetText}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Command="{Binding Search.SelectedFile.RevealInExplorerCommand}"
                                                        IsEnabled="{Binding Search.HasSelectedFile}"
                                                        Style="{StaticResource PreviewFooterButtonStyle}"
                                                        ToolTip="Reveal in Explorer">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource LineIconStyle}"
                                                              Margin="0,0,6,0" TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                                        <TextBlock Text="Show in folder" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        IsEnabled="{Binding Search.HasSelectedFile}"
                                                        Style="{StaticResource PreviewFooterButtonStyle}"
                                                        Click="OnCopyMenuButtonClick"
                                                        ToolTip="Copy the path, the preview, or the full file content">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Placement="Top"
                                                                     DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="Copy file _path" Command="{Binding Search.SelectedFile.CopyPathCommand}">
                                                                <MenuItem.Icon><ui:FontIcon Glyph="&#xE8C8;" FontSize="14"/></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Copy _folder path" Command="{Binding Search.SelectedFile.CopyFolderPathCommand}">
                                                                <MenuItem.Icon><ui:FontIcon Glyph="&#xE8C8;" FontSize="14"/></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Copy _preview" Command="{Binding Search.CopyPreviewCommand}">
                                                                <MenuItem.Icon><ui:FontIcon Glyph="&#xE7C3;" FontSize="14"/></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Copy file _content" Command="{Binding Search.CopyFileContentCommand}">
                                                                <MenuItem.Icon><ui:FontIcon Glyph="&#xE8E5;" FontSize="14"/></MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource LineIconStyle}"
                                                              Margin="0,0,6,0" TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                                        <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LineIcon14Style}"
                                                              StrokeThickness="1.4" Margin="6,0,0,0"
                                                              TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- body: OCR image, numbered code view, range footer -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Margin="16,10,16,0"
                                                    Visibility="{Binding Search.HasImageOcrPreview, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{DynamicResource PreviewImageCardStyle}">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Bottom"
                                                               Text="{Binding Search.ImageOcrPreview.Label}"
                                                               Style="{StaticResource HintLabelStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,8,0,0"/>
                                                    <Viewbox Stretch="Uniform">
                                                        <Canvas Width="{Binding Search.ImageOcrPreview.SourceWidth}"
                                                                Height="{Binding Search.ImageOcrPreview.SourceHeight}">
                                                            <Image Source="{Binding Search.ImageOcrPreview.ImagePath}"
                                                                   Width="{Binding Search.ImageOcrPreview.SourceWidth}"
                                                                   Height="{Binding Search.ImageOcrPreview.SourceHeight}"
                                                                   Stretch="Fill"/>
                                                            <Rectangle Canvas.Left="{Binding Search.ImageOcrPreview.X}"
                                                                       Canvas.Top="{Binding Search.ImageOcrPreview.Y}"
                                                                       Width="{Binding Search.ImageOcrPreview.Width}"
                                                                       Height="{Binding Search.ImageOcrPreview.Height}"
                                                                       Stroke="#FFFFCE54"
                                                                       StrokeThickness="6"
                                                                       Fill="#33FFCE54"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </DockPanel>
                                            </Border>

                                            <ListBox x:Name="PreviewLinesList" Grid.Row="1"
                                                     ItemsSource="{Binding Search.PreviewLines}"
                                                     ItemContainerStyle="{StaticResource PreviewLineItemStyle}"
                                                     AutomationProperties.Name="File preview"
                                                     MouseDoubleClick="OnPreviewLineDoubleClick">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox" BasedOn="{StaticResource PreviewLinesListStyle}">
                                                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Search.IsPreviewWrapEnabled}" Value="True">
                                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                                <ListBox.CommandBindings>
                                                    <CommandBinding Command="ApplicationCommands.Copy" Executed="OnPreviewLinesCopy"/>
                                                </ListBox.CommandBindings>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PreviewLineViewModel}">
                                                        <Grid Margin="0,1,14,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding LineNumberText}" Style="{StaticResource PreviewLineNumberStyle}"/>
                                                            <TextBlock Grid.Column="1" hl:HitHighlight.Hit="{Binding DisplayHit}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Search.IsPreviewWrapEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsGap}" Value="True">
                                                                                <Setter Property="FontFamily" Value="{DynamicResource Atlas.SansFont}"/>
                                                                                <Setter Property="FontSize" Value="11.5"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Atlas.Ink2Brush}"/>
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <Grid Grid.Row="2" Margin="66,6,14,8"
                                                  Visibility="{Binding Search.HasPreviewLines, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Search.PreviewRangeText}" FontSize="12"
                                                           Foreground="{DynamicResource Atlas.Ink2Brush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{Binding Search.WholeFileToggleText}"
                                                        Command="{Binding Search.ToggleWholeFilePreviewCommand}"
                                                        Style="{StaticResource AccentUnderlineLinkButtonStyle}"
                                                        Margin="6,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </DockPanel>

                                    <!-- empty -->
                                    <DockPanel>
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Search.SelectedFile}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Grid DockPanel.Dock="Top" Margin="16,10,12,0">
                                            <Button Command="{Binding Search.TogglePreviewPaneCommand}"
                                                    Style="{StaticResource PreviewNavButtonStyle}" Width="28" Height="28"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{DynamicResource Atlas.Ink2Brush}"
                                                    ToolTip="Hide preview" AutomationProperties.Name="Hide preview">
                                                <Path Data="{StaticResource Icon.PreviewToggle}" Style="{StaticResource LineIconStyle}"/>
                                            </Button>
                                        </Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                                            <Path Data="{StaticResource Icon.PreviewToggle}" Style="{StaticResource LineIconStyle}"
                                                  Opacity="0.3" Margin="0,0,0,12">
                                                <Path.LayoutTransform>
                                                    <ScaleTransform ScaleX="2.2" ScaleY="2.2"/>
                                                </Path.LayoutTransform>
                                            </Path>
                                            <TextBlock Text="Select a result" Style="{StaticResource EmptyTitleStyle}"/>
                                            <TextBlock Text="The matching lines and the code around them appear here, with each match highlighted."
                                                       Style="{StaticResource EmptyBodyStyle}"/>
                                        </StackPanel>
                                    </DockPanel>
