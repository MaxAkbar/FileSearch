<Window x:Class="FileSearch.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:FileSearch.Gui.ViewModels"
        xmlns:conv="clr-namespace:FileSearch.Gui.Converters"
        xmlns:hl="clr-namespace:FileSearch.Gui.Highlighting"
        xmlns:controls="clr-namespace:FileSearch.Gui.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowTitleBar.ExtendsContentIntoTitleBar="True"
        Icon="Assets/FileSearch.ico"
        Background="{DynamicResource Atlas.PaperBrush}"
        Foreground="{DynamicResource Atlas.InkBrush}"
        FontFamily="{DynamicResource Atlas.SansFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Title="FileSearch"
        Height="860"
        Width="1440"
        MinHeight="660"
        MinWidth="1120">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:FileTypeToBrushConverter x:Key="TypeBrush"/>
        <conv:FileTypeToTintBrushConverter x:Key="TypeTint"/>
        <conv:FileTypeToInkBrushConverter x:Key="TypeInk"/>
        <conv:FileTypeToLabelConverter x:Key="TypeLabel"/>
        <conv:ResultGroupStateConverter x:Key="ResultGroupState"/>
        <conv:FolderPathPartConverter x:Key="FolderPart"/>
        <conv:PathsEqualConverter x:Key="PathsEqual"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Hidden while a search runs (the Stop button takes its place). -->
        <Style x:Key="IdleOnlyStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Search.IsSearching}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Style="{StaticResource AppRootStyle}">

        <!-- ===== Title bar: sidebar toggle, brand, menu (caption buttons sit to the right) ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource TitleBarStyle}" BorderThickness="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSidebarCommand}"
                        Style="{StaticResource TitleIconButtonStyle}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Toggle sidebar"
                        ToolTip="Show or collapse the sidebar">
                    <Path Data="{StaticResource Icon.SidebarToggle}" Style="{StaticResource LineIconStyle}"/>
                </Button>
                <Image Source="Assets/FileSearch-256.png" Width="18" Height="18" Margin="2,0,8,0"
                       Visibility="{DynamicResource AppStyle.TitleIconVisibility}"/>
                <Border Style="{StaticResource BrandMarkStyle}"
                        Visibility="{DynamicResource AppStyle.TitleMarkVisibility}">
                    <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIcon12Style}" StrokeThickness="2.6"/>
                </Border>
                <TextBlock Text="{DynamicResource AppStyle.BrandName}" Style="{StaticResource BrandTextStyle}" Margin="0,0,14,0"/>
                <Menu Style="{StaticResource TitleMenuStyle}"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Install Windows integration"
                                  Command="{Binding InstallWindowsIntegrationCommand}"/>
                        <MenuItem Header="_Remove Windows integration"
                                  Command="{Binding RemoveWindowsIntegrationCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Settings..." Click="OnSettingsClick"/>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="OnExitClick"/>
                    </MenuItem>
                    <MenuItem Header="_Search">
                        <MenuItem Header="_Start" Command="{Binding Search.SearchCommand}" InputGestureText="Enter"/>
                        <MenuItem Header="_Cancel" Command="{Binding Search.CancelCommand}" InputGestureText="Esc"/>
                        <Separator/>
                        <MenuItem Header="Save current s_earch" Command="{Binding Search.SaveCurrentSearchCommand}"/>
                        <MenuItem Header="Save current _workspace" Command="{Binding Search.SaveWorkspaceCommand}"/>
                        <MenuItem Header="_Pin folder to locations" Command="{Binding Search.PinSearchFolderCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Regex tester..." Click="OnRegexTesterClick"/>
                        <MenuItem Header="_Workflows..." Click="OnWorkflowsClick"/>
                    </MenuItem>
                    <MenuItem Header="_Index">
                        <MenuItem Header="_Add current folder to index"
                                  Command="{Binding Index.AddCurrentFolderToIndexCommand}"/>
                        <MenuItem Header="_Manage indexed locations..."
                                  Click="OnManageIndexesClick"/>
                        <MenuItem Header="_Pause background indexing"
                                  Command="{Binding Index.PauseBackgroundIndexingCommand}"/>
                        <MenuItem Header="_Resume background indexing"
                                  Command="{Binding Index.ResumeBackgroundIndexingCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Open index location"
                                  Command="{Binding Index.OpenIndexLocationCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Side_bar" Command="{Binding ToggleSidebarCommand}"
                                  IsCheckable="True" IsChecked="{Binding Settings.IsSidebarExpanded, Mode=OneWay}"/>
                        <MenuItem Header="_Preview pane" Command="{Binding Search.TogglePreviewPaneCommand}"
                                  IsCheckable="True" IsChecked="{Binding Search.IsPreviewPaneVisible, Mode=OneWay}"/>
                        <Separator/>
                        <MenuItem Header="Theme">
                            <MenuItem Header="_Atlas (light)" Command="{Binding ApplyThemeCommand}" CommandParameter="Light"
                                      IsCheckable="True" IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"/>
                            <MenuItem Header="_Dark" Command="{Binding ApplyThemeCommand}" CommandParameter="Dark"
                                      IsCheckable="True" IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"/>
                            <MenuItem Header="Visual _Studio" Command="{Binding ApplyThemeCommand}" CommandParameter="VisualStudio"
                                      IsCheckable="True" IsChecked="{Binding IsVisualStudioThemeSelected, Mode=OneWay}"/>
                            <Separator/>
                            <MenuItem Header="S_ystem" Command="{Binding ApplyThemeCommand}" CommandParameter="System"
                                      IsCheckable="True" IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"/>
                        </MenuItem>
                        <MenuItem Header="Style">
                            <MenuItem Header="_Comfortable" Command="{Binding ApplyStyleCommand}" CommandParameter="Comfortable"
                                      IsCheckable="True" IsChecked="{Binding IsComfortableStyleSelected, Mode=OneWay}"/>
                            <MenuItem Header="_Compact" Command="{Binding ApplyStyleCommand}" CommandParameter="Compact"
                                      IsCheckable="True" IsChecked="{Binding IsCompactStyleSelected, Mode=OneWay}"/>
                            <MenuItem Header="_Vela" Command="{Binding ApplyStyleCommand}" CommandParameter="Vela"
                                      IsCheckable="True" IsChecked="{Binding IsVelaStyleSelected, Mode=OneWay}"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_User guide" Click="OnHelpClick"/>
                        <Separator/>
                        <MenuItem Header="_About" Click="OnAboutClick"/>
                    </MenuItem>
                </Menu>
                <Border Style="{DynamicResource TitleStatusPillStyle}"
                        Visibility="{DynamicResource AppStyle.TitleStatusVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource Atlas.Accent2Brush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                   Foreground="{DynamicResource Atlas.Ink2Brush}"
                                   Margin="7,0,0,0"
                                   MaxWidth="260">
                            <Run Text="{Binding Index.IndexActivityText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Index.IndexedLocationCountText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBarStyle}">
            <Grid MinHeight="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Atlas.AccentBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Status.Text}" Style="{StaticResource StatusLineTextStyle}"
                           Foreground="{DynamicResource Atlas.InkBrush}" MaxWidth="520"/>
                <TextBlock Grid.Column="2" Text="{Binding Search.ElapsedText}"
                           Style="{StaticResource StatusLineTextStyle}" Margin="10,0,0,0"
                           ToolTip="Elapsed time of the last search"/>
                <Path Grid.Column="4" Data="{StaticResource Icon.Database}" Style="{StaticResource LineIcon14Style}"
                      StrokeThickness="1.2" Margin="0,0,7,0" TextElement.Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Index.CurrentFolderIndexStatusText}"
                           Style="{StaticResource StatusLineTextStyle}" Foreground="{DynamicResource Atlas.InkBrush}"
                           MaxWidth="360"/>
                <Button Grid.Column="6" Content="Add to index"
                        Command="{Binding Index.AddCurrentFolderToIndexCommand}"
                        Style="{StaticResource AccentUnderlineLinkButtonStyle}"
                        Margin="6,0,0,0">
                    <Button.Visibility>
                        <Binding Path="Index.IsCurrentFolderIndexed" Converter="{StaticResource InverseBoolToVisibility}"/>
                    </Button.Visibility>
                </Button>
                <TextBlock Grid.Column="7" Style="{StaticResource StatusLineTextStyle}" Margin="12,0,0,0">
                    <Run Text="{Binding Index.IndexActivityText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Index.IndexedLocationCountText, Mode=OneWay}"/>
                </TextBlock>
                <Border Grid.Column="8" Width="1" Height="14"
                        Background="{DynamicResource Atlas.Line2Brush}"
                        Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{DynamicResource AppStyle.StatusThemeToggleVisibility}"/>
                <Border Grid.Column="9" Style="{StaticResource SegmentedControlStyle}"
                        Margin="14,0,0,0"
                        Visibility="{DynamicResource AppStyle.StatusThemeToggleVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dark"
                                Command="{Binding ApplyThemeCommand}" CommandParameter="Dark"
                                Tag="{Binding IsDarkThemeSelected}"
                                FontSize="11" Padding="10,2"
                                Style="{StaticResource SegmentedItemButtonStyle}"/>
                        <Button Content="Light"
                                Command="{Binding ApplyThemeCommand}" CommandParameter="Light"
                                Tag="{Binding IsLightThemeSelected}"
                                FontSize="11" Padding="10,2"
                                Style="{StaticResource SegmentedItemButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Center shell: sidebar | splitter | main surface ===== -->
        <Grid x:Name="ShellRoot" Style="{StaticResource ShellStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="{DynamicResource AppDensity.SidebarColumnWidth}"
                                  MinWidth="220"
                                  MaxWidth="440"/>
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto"/>
                <ColumnDefinition x:Name="MainColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar (full) ===== -->
            <DockPanel Grid.Column="0"
                       Margin="{DynamicResource AppDensity.SidebarShellPadding}"
                       Visibility="{Binding Settings.IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">

                <!-- Footer: theme/style switchers (style-dependent) and commands. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel Visibility="{DynamicResource AppStyle.SidebarThemeSwitcherVisibility}">
                        <TextBlock Text="THEME" Style="{StaticResource NavSectionLabelStyle}"/>
                        <UniformGrid Columns="4" Rows="1" Margin="6,0,6,8">
                            <Button Content="Atlas" Command="{Binding ApplyThemeCommand}" CommandParameter="Light"
                                    Tag="{Binding IsLightThemeSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Dark" Command="{Binding ApplyThemeCommand}" CommandParameter="Dark"
                                    Tag="{Binding IsDarkThemeSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="VS" Command="{Binding ApplyThemeCommand}" CommandParameter="VisualStudio"
                                    Tag="{Binding IsVisualStudioThemeSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Sys" Command="{Binding ApplyThemeCommand}" CommandParameter="System"
                                    Tag="{Binding IsSystemThemeSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}"/>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Visibility="{DynamicResource AppStyle.SidebarStyleSwitcherVisibility}">
                        <TextBlock Text="STYLE" Style="{StaticResource NavSectionLabelStyle}"/>
                        <UniformGrid Columns="3" Rows="1" Margin="6,0,6,8">
                            <Button Content="Roomy" Command="{Binding ApplyStyleCommand}" CommandParameter="Comfortable"
                                    Tag="{Binding IsComfortableStyleSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Compact" Command="{Binding ApplyStyleCommand}" CommandParameter="Compact"
                                    Tag="{Binding IsCompactStyleSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Vela" Command="{Binding ApplyStyleCommand}" CommandParameter="Vela"
                                    Tag="{Binding IsVelaStyleSelected}"
                                    Style="{StaticResource ThemeMiniButtonStyle}"/>
                        </UniformGrid>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource Atlas.LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <StackPanel>
                            <Button Click="OnWorkflowsClick" Style="{StaticResource SidebarFooterButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Workflow}" Style="{StaticResource SidebarRowIconStyle}"/>
                                    <TextBlock Text="Workflows" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnSettingsClick" Style="{StaticResource SidebarFooterButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource SidebarRowIconStyle}"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section cards; the stack scrolls as one surface. -->
                <ScrollViewer x:Name="SidebarScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="0,0,2,0">
                        <Expander x:Name="LocationsSection" Style="{StaticResource SidebarSectionStyle}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LOCATIONS" Style="{StaticResource SidebarSectionTitleStyle}"/>
                                    <TextBlock Text="{Binding History.LocationList.CountText}" Style="{StaticResource SidebarSectionCountStyle}"
                                               Visibility="{Binding History.LocationList.HasContent, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Expander.Header>
                            <Expander.Tag>
                                <Button Command="{Binding Search.AddLocationCommand}" Style="{StaticResource SidebarMiniButtonStyle}"
                                        ToolTip="Add location" AutomationProperties.Name="Add location">
                                    <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.4"/>
                                </Button>
                            </Expander.Tag>
                            <Grid>
                                <StackPanel Visibility="{Binding History.LocationList.HasContent, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="2,2,2,4">
                                        <TextBox Text="{Binding History.LocationList.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SidebarFilterBoxStyle}"
                                                 ui:ControlHelper.PlaceholderText="Filter locations"
                                                 AutomationProperties.Name="Filter locations"/>
                                        <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIcon14Style}"
                                              HorizontalAlignment="Left" Margin="8,0,0,0"
                                              TextElement.Foreground="{DynamicResource Atlas.Ink3Brush}"/>
                                        <Button Command="{Binding History.LocationList.ClearSearchCommand}"
                                                Style="{StaticResource SidebarMiniButtonStyle}"
                                                HorizontalAlignment="Right" Margin="0,0,3,0" ToolTip="Clear filter"
                                                Visibility="{Binding History.LocationList.HasSearchText, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon12Style}"/>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding History.LocationList.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.Search.UseLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SidebarRowButtonStyle}"
                                                        ToolTip="{Binding}">
                                                    <Button.Tag>
                                                        <MultiBinding Converter="{StaticResource PathsEqual}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.Search.SearchPath" ElementName="ShellRoot"/>
                                                        </MultiBinding>
                                                    </Button.Tag>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource Icon.Folder}">
                                                            <Path.Style>
                                                                <Style TargetType="Path" BasedOn="{StaticResource SidebarRowIconStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{StaticResource AppStyle.BooleanTrue}">
                                                                            <Setter Property="Stroke" Value="{DynamicResource Atlas.AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource SidebarRowLabelStyle}"/>
                                                        <Button Grid.Column="2"
                                                                Command="{Binding DataContext.History.RemoveLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SidebarRowActionButtonStyle}"
                                                                ToolTip="Remove location" AutomationProperties.Name="Remove location">
                                                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon12Style}"/>
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,2,0,0" MinHeight="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding History.LocationList.PreviousPageCommand}" Style="{StaticResource SidebarMiniButtonStyle}"
                                                ToolTip="Previous page" AutomationProperties.Name="Previous page"
                                                Visibility="{Binding History.LocationList.IsPagerVisible, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="{StaticResource Icon.ChevronLeft}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.5"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding History.LocationList.PageSummaryText}"
                                                   Style="{StaticResource SidebarPagerTextStyle}" FontSize="12" Margin="4,0"
                                                   Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                        <Button Grid.Column="2" Command="{Binding History.LocationList.NextPageCommand}" Style="{StaticResource SidebarMiniButtonStyle}"
                                                ToolTip="Next page" AutomationProperties.Name="Next page"
                                                Visibility="{Binding History.LocationList.IsPagerVisible, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.5"/>
                                        </Button>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="Clear all" Command="{Binding History.ClearLocationsCommand}"
                                                    Style="{StaticResource UnderlineLinkButtonStyle}" AutomationProperties.Name="Clear locations"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding History.LocationList.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <Button Command="{Binding Search.AddLocationCommand}" Style="{StaticResource SidebarRowButtonStyle}" Foreground="{DynamicResource Atlas.Ink2Brush}" FontSize="12.5">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource LineIconStyle}" StrokeThickness="1.4" Margin="0,0,10,0"/>
                                            <TextBlock Text="Add a location" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander x:Name="RecentSection" Style="{StaticResource SidebarSectionStyle}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RECENT FOLDERS" Style="{StaticResource SidebarSectionTitleStyle}"/>
                                    <TextBlock Text="{Binding History.RecentPathList.CountText}" Style="{StaticResource SidebarSectionCountStyle}"
                                               Visibility="{Binding History.RecentPathList.HasContent, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Expander.Header>

                            <Grid>
                                <StackPanel Visibility="{Binding History.RecentPathList.HasContent, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="2,2,2,4">
                                        <TextBox Text="{Binding History.RecentPathList.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SidebarFilterBoxStyle}"
                                                 ui:ControlHelper.PlaceholderText="Filter recent folders"
                                                 AutomationProperties.Name="Filter recent folders"/>
                                        <Path Data="{StaticResource Icon.Search}" Style="{StaticResource LineIcon14Style}"
                                              HorizontalAlignment="Left" Margin="8,0,0,0"
                                              TextElement.Foreground="{DynamicResource Atlas.Ink3Brush}"/>
                                        <Button Command="{Binding History.RecentPathList.ClearSearchCommand}"
                                                Style="{StaticResource SidebarMiniButtonStyle}"
                                                HorizontalAlignment="Right" Margin="0,0,3,0" ToolTip="Clear filter"
                                                Visibility="{Binding History.RecentPathList.HasSearchText, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon12Style}"/>
                                        </Button>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding History.RecentPathList.Items}"
                                             SelectedItem="{Binding Search.SelectedRecentPath, Mode=TwoWay}"
                                             Style="{StaticResource SidebarRowListStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="{StaticResource Icon.Clock}" Style="{StaticResource SidebarRowIconStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource FolderPart}, ConverterParameter=leaf}"
                                                               Style="{StaticResource SidebarRowLabelStyle}" MaxWidth="130"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource FolderPart}}"
                                                               Style="{StaticResource SidebarRowSubStyle}"/>
                                                    <Button Grid.Column="3"
                                                            Command="{Binding DataContext.History.RemoveRecentPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SidebarRowActionButtonStyle}"
                                                            ToolTip="Remove from recent folders" AutomationProperties.Name="Remove from recent folders">
                                                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LineIcon12Style}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Margin="0,2,0,0" MinHeight="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding History.RecentPathList.PreviousPageCommand}" Style="{StaticResource SidebarMiniButtonStyle}"
                                                ToolTip="Previous page" AutomationProperties.Name="Previous page"
                                                Visibility="{Binding History.RecentPathList.IsPagerVisible, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="{StaticResource Icon.ChevronLeft}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.5"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding History.RecentPathList.PageSummaryText}"
                                                   Style="{StaticResource SidebarPagerTextStyle}" FontSize="12" Margin="4,0"
                                                   Foreground="{DynamicResource Atlas.Ink2Brush}"/>
                                        <Button Grid.Column="2" Command="{Binding History.RecentPathList.NextPageCommand}" Style="{StaticResource SidebarMiniButtonStyle}"
                                                ToolTip="Next page" AutomationProperties.Name="Next page"
                                                Visibility="{Binding History.RecentPathList.IsPagerVisible, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.5"/>
                                        </Button>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="Clear all" Command="{Binding History.ClearRecentPathsCommand}"
                                                    Style="{StaticResource UnderlineLinkButtonStyle}" AutomationProperties.Name="Clear recent folders"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding History.RecentPathList.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <Grid MinHeight="30" Margin="10,4,10,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource Icon.Clock}" Style="{StaticResource LineIconStyle}" Margin="0,0,10,0"
                                              TextElement.Foreground="{DynamicResource Atlas.Ink3Brush}"/>
                                        <TextBlock Grid.Column="1" Text="Folders you search will appear here" Style="{StaticResource SidebarEmptyHintStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander x:Name="SavedSection" Style="{StaticResource SidebarSectionStyle}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SAVED SEARCHES" Style="{StaticResource SidebarSectionTitleStyle}"/>
                                    <TextBlock Text="{Binding History.SavedSearchList.CountText}" Style="{StaticResource SidebarSectionCountStyle}"
                                               Visibility="{Binding History.SavedSearchList.HasContent, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Expander.Header>
                            <Expander.Tag>
                                <Button Command="{Binding Search.SaveCurrentSearchCommand}" Style="{StaticResource SidebarMiniButtonStyle}"
                                        ToolTip="Save current search" AutomationProperties.Name="Save current search">
                                    <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource LineIcon14Style}" StrokeThickness="1.4"/>
                                </Button>
                            </Expander.Tag>
                            <Grid>
                                <StackPanel Visibility="{Binding History.SavedSearchList.HasContent, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="2,2,2,4">
                                        <TextBox Text="{Binding History.SavedSearchList.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SidebarFilterBoxStyle}"
